# Dist builder output and packaged tarballs
/build/dist/*
!/build/dist/.gitkeep
/build/cache/*
!/build/cache/.gitkeep
/build/package/*
!/build/package/.gitkeep

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
medora/medora

# Test / coverage
*.out
coverage.*
*.coverprofile
profile.cov

# Go
go.work
go.work.sum

# Env & data
.env
/data/
!data/.gitkeep
medora/.env

# Editor
.idea/
.vscode/
