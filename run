#!/usr/bin/env bash
# Medora host TUI — container lifecycle only (no backup/restore).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
DATA="$ROOT/data"
ENGINE_FILE="$DATA/.engine"
COMPOSE_FILE="$ROOT/medora/compose.yaml"
COMPOSE_DIR="$ROOT/medora"

RED=$'\033[31m'; GREEN=$'\033[32m'; CYAN=$'\033[36m'; YELLOW=$'\033[33m'
DIM=$'\033[2m'; BOLD=$'\033[1m'; REV=$'\033[7m'; RESET=$'\033[0m'

if [[ ! -t 0 || ! -t 1 ]]; then
  echo "Medora ./run requires a TTY. Use: podman compose -f medora/compose.yaml --project-directory medora ..." >&2
  exit 1
fi

mkdir -p "$DATA"

podman_ok=0
docker_ok=0
podman_compose=()
docker_compose=()

# Compose files use paths relative to medora/; run compose from that directory.
if command -v podman >/dev/null 2>&1 && command -v podman-compose >/dev/null 2>&1; then
  podman_ok=1
  podman_compose=(podman-compose -f compose.yaml)
fi
if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
  docker_ok=1
  docker_compose=(docker compose -f compose.yaml)
fi

ENGINE=""
if [[ -f "$ENGINE_FILE" ]]; then
  ENGINE="$(tr -d '[:space:]' < "$ENGINE_FILE" || true)"
fi
if [[ "$ENGINE" == "podman" && "$podman_ok" -eq 1 ]]; then
  :
elif [[ "$ENGINE" == "docker" && "$docker_ok" -eq 1 ]]; then
  :
elif [[ "$podman_ok" -eq 1 ]]; then
  ENGINE=podman
elif [[ "$docker_ok" -eq 1 ]]; then
  ENGINE=docker
else
  ENGINE=""
fi

compose() {
  if [[ "$ENGINE" == "podman" ]]; then
    ( cd "$COMPOSE_DIR" && "${podman_compose[@]}" "$@" )
  elif [[ "$ENGINE" == "docker" ]]; then
    ( cd "$COMPOSE_DIR" && "${docker_compose[@]}" "$@" )
  else
    echo "${RED}No container engine available${RESET}" >&2
    return 1
  fi
}

save_engine() {
  mkdir -p "$DATA"
  printf '%s\n' "$ENGINE" > "$ENGINE_FILE"
}

cleanup() { stty sane 2>/dev/null || true; printf '\033[?25h'; }
trap cleanup EXIT
stty -echo -icanon time 0 min 0 2>/dev/null || true
printf '\033[?25l'

read_key() {
  local k rest
  IFS= read -r -n1 k || return 1
  if [[ "$k" == $'\033' ]]; then
    IFS= read -r -n2 rest || true
    echo "ESC$rest"
  elif [[ "$k" == "" ]]; then
    echo ENTER
  elif [[ "$k" == $'\t' ]]; then
    echo TAB
  elif [[ "$k" == " " ]]; then
    echo SPACE
  else
    echo "$k"
  fi
}

draw_main() {
  local sel=$1
  local items=("Start" "Stop" "Logs" "Status" "Engine" "Quit")
  clear
  echo "${CYAN}${BOLD}Medora${RESET}  ${DIM}engine: ${ENGINE:-none}${RESET}"
  echo
  local i=0
  for it in "${items[@]}"; do
    if [[ $i -eq $sel ]]; then
      echo "  ${REV}${GREEN}▸ $it${RESET}"
    else
      echo "  $it"
    fi
    i=$((i+1))
  done
  echo
  echo "${DIM}↑/↓ move · Enter/Space select · Esc quit${RESET}"
}

do_start() {
  mkdir -p "$DATA/store" "$DATA/transcode" "$DATA/backups"
  # Ensure container UID 1000 can write even if host created these as root.
  chmod 777 "$DATA" "$DATA/store" "$DATA/transcode" "$DATA/backups" 2>/dev/null || true
  chown -R 1000:1000 "$DATA/store" "$DATA/transcode" "$DATA/backups" 2>/dev/null || true
  if [[ ! -f "$COMPOSE_DIR/.env" && -f "$COMPOSE_DIR/.env.example" ]]; then
    echo "${YELLOW}Copy medora/.env.example to medora/.env and set MEDIA_PATH${RESET}"
  fi
  # Rebuild image (UI is go:embed'd) and always recreate the container so :7676 runs the new binary.
  compose build
  compose up -d --force-recreate --build
  echo "${GREEN}Started${RESET}"; sleep 1
}

do_status() {
  compose ps || true
  echo
  if curl -sf http://127.0.0.1:7676/healthz; then
    echo
    echo "${GREEN}healthz ok${RESET}"
  else
    echo "${RED}healthz failed${RESET}"
    echo "${DIM}--- recent logs ---${RESET}"
    compose logs --tail 40 medora 2>/dev/null || compose logs --tail 40 || true
  fi
}

do_engine_menu() {
  local sel=0
  while true; do
    clear
    echo "${CYAN}${BOLD}Container engine${RESET}"
    echo
    local label0="Podman"
    local label1="Docker"
    [[ "$podman_ok" -eq 1 ]] && label0+="  ${GREEN}[detected]${RESET}" || label0+="  ${DIM}(not found)${RESET}"
    [[ "$docker_ok" -eq 1 ]] && label1+="  ${GREEN}[detected]${RESET}" || label1+="  ${DIM}(not found)${RESET}"
    [[ "$ENGINE" == "podman" ]] && label0="${BOLD}$label0${RESET}"
    [[ "$ENGINE" == "docker" ]] && label1="${BOLD}$label1${RESET}"
    if [[ $sel -eq 0 ]]; then echo "  ${REV}▸ $label0${RESET}"; else echo "  $label0"; fi
    if [[ $sel -eq 1 ]]; then echo "  ${REV}▸ $label1${RESET}"; else echo "  $label1"; fi
    echo "  Back"
    [[ $sel -eq 2 ]] && echo -ne "\033[1A\r  ${REV}▸ Back${RESET}\n"
    echo
    echo "${DIM}Esc back${RESET}"
    local key; key="$(read_key)"
    case "$key" in
      ESC[A) sel=$(( (sel+2)%3 ));;
      ESC[B) sel=$(( (sel+1)%3 ));;
      ENTER|SPACE)
        if [[ $sel -eq 0 && $podman_ok -eq 1 ]]; then ENGINE=podman; save_engine; return; fi
        if [[ $sel -eq 1 && $docker_ok -eq 1 ]]; then ENGINE=docker; save_engine; return; fi
        if [[ $sel -eq 2 ]]; then return; fi
        ;;
      ESC*) return ;;
    esac
  done
}

main_sel=0
while true; do
  draw_main "$main_sel"
  key="$(read_key)"
  case "$key" in
    ESC[A) main_sel=$(( (main_sel+5)%6 ));;
    ESC[B) main_sel=$(( (main_sel+1)%6 ));;
    ESC*) break ;;
    ENTER|SPACE)
      case $main_sel in
        0) stty sane; printf '\033[?25h'; do_start; stty -echo -icanon time 0 min 0; printf '\033[?25l' ;;
        1) stty sane; printf '\033[?25h'; compose stop; sleep 1; stty -echo -icanon time 0 min 0; printf '\033[?25l' ;;
        2) stty sane; printf '\033[?25h'; compose logs -f medora || true; stty -echo -icanon time 0 min 0; printf '\033[?25l' ;;
        3) stty sane; printf '\033[?25h'; do_status; read -r -p "Enter…"; stty -echo -icanon time 0 min 0; printf '\033[?25l' ;;
        4) do_engine_menu ;;
        5) break ;;
      esac
      ;;
  esac
done
