# Musl servemedia. CGO is required: purego's CGO-off path imports glibc sonames.
FROM docker.io/library/golang:1.26-alpine
RUN apk add --no-cache gcc musl-dev
WORKDIR /src
COPY src/go.mod src/go.sum ./
ENV CGO_ENABLED=1 GOOS=linux GOARCH=amd64 GOFLAGS=-buildvcs=false
RUN go mod download
COPY src/ ./
COPY build/apprun-musl.c /tmp/apprun-musl.c
RUN go build -ldflags="-s -w" -o /srv/servemedia-musl ./cmd \
	&& gcc -static -O2 -s -o /srv/servemedia-apprun /tmp/apprun-musl.c \
	&& chmod a+x /srv/servemedia-musl /srv/servemedia-apprun
CMD ["sh", "-c", "cp -a /srv/servemedia-musl /srv/servemedia-apprun /cache/ && chmod a+rwx /cache/servemedia-musl /cache/servemedia-apprun"]
