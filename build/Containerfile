# syntax=docker/dockerfile:1
# Build context: repo root. Dist builder, not a runtime.

FROM docker.io/library/golang:1.26-bookworm AS go
WORKDIR /src
COPY medora/go.mod medora/go.sum ./
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOFLAGS=-buildvcs=false
RUN go mod download
COPY medora/ ./
RUN go build -ldflags="-s -w" -o /out/medora ./cmd/medora

FROM docker.io/library/debian:trixie-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils bash \
    gcc g++ make nasm pkg-config \
    libva-dev libdrm-dev \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /dist
COPY --from=go /out/medora /dist/medora
COPY medora/share/config /dist/config
COPY medora/share/applications /dist/share/applications
COPY medora/web/static/app.css medora/web/static/app.js medora/web/static/logo.svg medora/web/static/placeholder.svg /dist/public/
COPY LICENSE /dist/LICENSE
COPY build/build /build
RUN chmod +x /build && /build vendor
CMD ["/build", "stage"]
