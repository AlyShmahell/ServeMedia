# syntax=docker/dockerfile:1
# Build context: repo root. Dist builder, not a runtime.

FROM docker.io/library/golang:1.26-bookworm AS go
WORKDIR /src
COPY servemedia/go.mod servemedia/go.sum ./
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOFLAGS=-buildvcs=false
RUN go mod download
COPY servemedia/ ./
RUN go build -ldflags="-s -w" -o /out/servemedia ./cmd/servemedia

FROM docker.io/library/debian:trixie-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils bash \
    gcc g++ make nasm pkg-config \
    libva-dev libdrm-dev \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /dist
COPY --from=go /out/servemedia /dist/servemedia
COPY servemedia/share/config /dist/config
COPY servemedia/share/applications /dist/share/applications
COPY servemedia/web/static/app.css servemedia/web/static/app.js servemedia/web/static/controls.js servemedia/web/static/logo.svg servemedia/web/static/placeholder.svg /dist/public/
COPY LICENSE /dist/LICENSE
COPY build/build /build
RUN chmod +x /build && /build vendor
CMD ["/build", "stage"]
