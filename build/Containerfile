# syntax=docker/dockerfile:1
# Build context: repo root. Dist builder, not a runtime.

FROM docker.io/library/golang:1.26-bookworm AS go
WORKDIR /src
COPY src/go.mod src/go.sum ./
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOFLAGS=-buildvcs=false
RUN go mod download
COPY src/ ./
RUN go build -ldflags="-s -w" -o /out/servemedia ./cmd

FROM docker.io/library/debian:trixie-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils bash \
    gcc g++ make nasm pkg-config \
    cmake meson ninja-build python3 yasm \
    libva-dev libdrm-dev \
    patchelf binutils \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /dist
COPY --from=go /out/servemedia /dist/.local/bin/servemedia
COPY src/share/config /dist/.local/share/servemedia/config
COPY src/share/applications /dist/.local/share/applications
COPY src/web/static/app.css src/web/static/app.js src/web/static/controls.js src/web/static/logo.svg src/web/static/placeholder.svg /dist/.local/share/servemedia/public/
COPY LICENSE /dist/LICENSE
COPY LICENSE /dist/.local/share/servemedia/LICENSE
COPY build/build /build
RUN chmod +x /build && /build vendor
CMD ["/build", "stage"]
