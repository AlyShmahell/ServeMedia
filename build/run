#!/usr/bin/env bash
# Build a host dist, then run it or pack it.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

COMPOSE_FILE="$DIR/compose.yaml"

compose() {
  if command -v podman-compose >/dev/null 2>&1; then
    podman-compose -f "$COMPOSE_FILE" "$@"
  elif command -v podman >/dev/null 2>&1 && podman compose version >/dev/null 2>&1; then
    podman compose -f "$COMPOSE_FILE" "$@"
  elif command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    docker compose -f "$COMPOSE_FILE" "$@"
  else
    echo "error: need podman-compose, podman compose, or docker compose" >&2
    exit 1
  fi
}

yaml_quote() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

path_has_glob() {
  case "$1" in
    *'*'*|*'?'*|*'['*) return 0 ;;
    *) return 1 ;;
  esac
}

# Buildah globs the context path, so a literal * in the repo path matches nothing.
prepare_compose() {
  local root dest
  root="$(cd "$DIR/.." && pwd)"
  COMPOSE_FILE="$DIR/compose.yaml"
  if ! path_has_glob "$root"; then
    return 0
  fi
  dest="${XDG_CACHE_HOME:-$HOME/.cache}/servemedia/build-context"
  rm -rf "$dest"
  mkdir -p "$dest"
  tar -C "$root" \
    --exclude=./build/cache \
    --exclude=./build/dist \
    --exclude=./build/package \
    --exclude=./.git \
    -cf - . | tar -C "$dest" -xf -
  COMPOSE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/servemedia/compose.yaml"
  cat >"$COMPOSE_FILE" <<EOF
services:
  dist:
    build:
      context: $(yaml_quote "$dest")
      dockerfile: $(yaml_quote "$dest/build/Containerfile")
    volumes:
      - $(yaml_quote "$DIR/dist:/out:z")
      - $(yaml_quote "$DIR/cache:/cache:z")
      - $(yaml_quote "$DIR/package:/package:z")
  ffmpeg-musl:
    build:
      context: $(yaml_quote "$dest")
      dockerfile: $(yaml_quote "$dest/build/Containerfile.musl")
    volumes:
      - $(yaml_quote "$DIR/cache:/cache:z")
  servemedia-musl:
    build:
      context: $(yaml_quote "$dest")
      dockerfile: $(yaml_quote "$dest/build/Containerfile.servemedia-musl")
    volumes:
      - $(yaml_quote "$DIR/cache:/cache:z")
EOF
}

rebuild() {
  mkdir -p "$DIR/dist" "$DIR/cache" "$DIR/package"
  : >"$DIR/dist/.gitkeep"
  : >"$DIR/cache/.gitkeep"
  prepare_compose
  compose up --build --force-recreate --abort-on-container-exit --no-deps dist
}

stage_package() {
  local staging="$1"
  mkdir -p "$staging/servemedia"
  cp -a "$DIR/dist"/. "$staging/servemedia/"
  rm -f "$staging/servemedia/.gitkeep"
  rm -rf "$staging/servemedia/data"
  if [[ ! -f "$staging/servemedia/LICENSE" ]]; then
    if [[ ! -f "$DIR/../LICENSE" ]]; then
      echo "error: $DIR/../LICENSE not found" >&2
      exit 1
    fi
    cp "$DIR/../LICENSE" "$staging/servemedia/LICENSE"
  fi
}

write_tar() {
  local staging="$1" name="$2"
  tar -C "$staging" -czf "$DIR/package/$name" servemedia
  echo "wrote $DIR/package/$name"
}

require_vendor_tree() {
  local root="$DIR/dist/.local/share/servemedia/vendor"
  local manifest="$DIR/../src/share/vendor.yaml"
  local missing=0 dest
  if [[ ! -f "$manifest" ]]; then
    echo "error: $manifest not found" >&2
    exit 1
  fi
  while IFS= read -r dest; do
    if [[ ! -s "$root/$dest" ]]; then
      echo "error: missing $root/$dest" >&2
      missing=1
    fi
  done < <(python3 - "$manifest" <<'PY'
import sys
path = sys.argv[1]
section = ""
cur = None
items = []

def flush():
    global cur
    if cur and cur.get("dest"):
        items.append(cur["dest"])
    cur = None

with open(path, encoding="utf-8") as f:
    for line in f:
        raw = line.rstrip("\n")
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        if raw[0] not in " \t":
            flush()
            section = raw.split(":", 1)[0].strip()
            continue
        if section != "assets":
            continue
        s = raw.strip()
        if s.startswith("- "):
            flush()
            cur = {}
            s = s[2:].strip()
            if not s:
                continue
        if cur is None or ":" not in s:
            continue
        k, _, v = s.partition(":")
        cur[k.strip()] = v.strip().strip('"').strip("'")
flush()
for dest in items:
    print(dest)
PY
)
  for dest in ffmpeg/ffmpeg ffmpeg/ffprobe; do
    if [[ ! -f "$root/$dest" ]]; then
      echo "error: missing $root/$dest" >&2
      missing=1
    fi
  done
  if [[ "$missing" -ne 0 ]]; then
    echo "error: vendor tree incomplete; rebuild dist so the builder can fetch it" >&2
    exit 1
  fi
}

elf_interp() {
  readelf -l "$1" | sed -n 's/.*Requesting program interpreter: \(.*\)\]/\1/p'
}

require_ld_linux() {
  local bin="$1" interp
  interp="$(elf_interp "$bin")"
  case "$interp" in
    *ld-linux*)
      echo "$bin interpreter: $interp"
      ;;
    *)
      echo "error: $bin interpreter is ${interp:-unset}; expected ld-linux" >&2
      exit 1
      ;;
  esac
}

require_ld_musl() {
  local bin="$1" interp
  interp="$(elf_interp "$bin")"
  case "$interp" in
    *ld-musl*)
      echo "$bin interpreter: $interp"
      ;;
    *)
      echo "error: $bin interpreter is ${interp:-unset}; expected ld-musl" >&2
      exit 1
      ;;
  esac
  if readelf -d "$bin" | grep -q 'libc\.so\.6'; then
    echo "error: $bin needs libc.so.6" >&2
    exit 1
  fi
}

ensure_musl_ffmpeg() {
  local cache="$DIR/cache/ffmpeg-musl"
  if [[ ! -x "$cache/ffmpeg" || ! -x "$cache/ffprobe" ]]; then
    echo "compiling musl ffmpeg into $cache"
    compose build ffmpeg-musl
    compose run --rm --no-deps ffmpeg-musl
  else
    echo "using cached musl ffmpeg from $cache"
  fi
  if [[ ! -x "$cache/ffmpeg" || ! -x "$cache/ffprobe" ]]; then
    echo "error: musl ffmpeg missing in $cache" >&2
    exit 1
  fi
  require_ld_musl "$cache/ffmpeg"
}

ensure_musl_servemedia() {
  echo "building musl servemedia into $DIR/cache"
  compose build servemedia-musl
  compose run --rm --no-deps servemedia-musl
  if [[ ! -x "$DIR/cache/servemedia-musl" || ! -x "$DIR/cache/servemedia-apprun" ]]; then
    echo "error: musl servemedia missing in $DIR/cache" >&2
    exit 1
  fi
  require_ld_musl "$DIR/cache/servemedia-musl"
}

stage_musl_package() {
  local staging="$1"
  local share ff
  stage_package "$staging"
  share="$staging/servemedia/.local/share/servemedia"
  ff="$share/vendor/ffmpeg"
  rm -rf "$ff"
  mkdir -p "$ff"
  cp -a "$DIR/cache/ffmpeg-musl/ffmpeg" "$DIR/cache/ffmpeg-musl/ffprobe" "$ff/"
  if [[ -f "$DIR/cache/ffmpeg-musl/LICENSE" ]]; then
    cp -a "$DIR/cache/ffmpeg-musl/LICENSE" "$ff/"
  fi
  if [[ -f "$DIR/cache/ffmpeg-musl/LICENSE.NOTICE" ]]; then
    cp -a "$DIR/cache/ffmpeg-musl/LICENSE.NOTICE" "$ff/"
  fi
  chmod a+x "$ff/ffmpeg" "$ff/ffprobe"
  cp -a "$DIR/cache/servemedia-musl" "$staging/servemedia/.local/bin/servemedia"
  chmod a+x "$staging/servemedia/.local/bin/servemedia"
  require_ld_musl "$staging/servemedia/.local/bin/servemedia"
  require_ld_musl "$ff/ffmpeg"
}

package() {
  if [[ ! -x "$DIR/dist/.local/bin/servemedia" ]]; then
    echo "error: build/dist/.local/bin/servemedia not found; rebuild first" >&2
    exit 1
  fi
  mkdir -p "$DIR/package"
  : >"$DIR/package/.gitkeep"
  prepare_compose
  require_vendor_tree
  require_ld_linux "$DIR/dist/.local/bin/servemedia"
  require_ld_linux "$DIR/dist/.local/share/servemedia/vendor/ffmpeg/ffmpeg"
  ensure_musl_ffmpeg
  ensure_musl_servemedia
  local staging

  staging="$(mktemp -d)"
  stage_package "$staging"
  rm -rf "$staging/servemedia/.local/share/servemedia/vendor/ffmpeg/musl"
  write_tar "$staging" "servemedia-linux-amd64-glibc.tar.gz"
  rm -rf "$staging"

  staging="$(mktemp -d)"
  stage_musl_package "$staging"
  write_tar "$staging" "servemedia-linux-amd64-musl.tar.gz"
  rm -rf "$staging"
  compose run --rm dist /build/build appimage "/package/servemedia-linux-amd64-glibc.tar.gz"
  compose run --rm dist /build/build appimage-musl "/package/servemedia-linux-amd64-musl.tar.gz"
}

start() {
  if [[ ! -x "$DIR/dist/.local/bin/servemedia" ]]; then
    echo "error: build/dist/.local/bin/servemedia not found; pick a rebuild option" >&2
    exit 1
  fi
  local xdg="$DIR/cache/xdg"
  mkdir -p "$xdg/.local/bin" \
    "$xdg/.local/share/servemedia" \
    "$xdg/.local/share/applications" \
    "$xdg/.local/state" \
    "$xdg/.cache" \
    "$xdg/.config"
  rm -rf "$xdg/.local/bin/servemedia" \
    "$xdg/.local/share/servemedia" \
    "$xdg/.local/share/applications/servemedia.desktop"
  cp -a "$DIR/dist/.local/." "$xdg/.local/"
  export HOME="$xdg"
  unset XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME XDG_CONFIG_HOME SERVEMEDIA_ROOT
  exec "$xdg/.local/bin/servemedia" "$@"
}

ALPINE_IMAGE="localhost/servemedia:alpine"
ALPINE_REMOTE="ghcr.io/alyshmahell/servemedia"

engine() {
  if command -v podman >/dev/null 2>&1; then
    podman "$@"
  elif command -v docker >/dev/null 2>&1; then
    docker "$@"
  else
    echo "error: need podman or docker" >&2
    exit 1
  fi
}

engine_name() {
  if command -v podman >/dev/null 2>&1; then
    echo podman
  elif command -v docker >/dev/null 2>&1; then
    echo docker
  else
    echo "error: need podman or docker" >&2
    exit 1
  fi
}

app_version() {
  awk '
    $1 == "version:" {
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "")
      gsub(/^"/, "")
      gsub(/"[[:space:]]*$/, "")
      print
      exit
    }
  ' "$DIR/../src/share/config/default.yaml"
}

alpine_image_present() {
  engine image inspect "$ALPINE_IMAGE" >/dev/null 2>&1
}

alpine_context() {
  local dest
  dest="$(mktemp -d "${TMPDIR:-/tmp}/servemedia-alpine.XXXXXX")"
  mkdir -p "$dest/build/cache/ffmpeg-musl"
  tar -C "$DIR/.." -cf - \
    src \
    build/build \
    LICENSE \
    | tar -C "$dest" -xf -
  cp -a "$DIR/alpine-entrypoint" "$dest/build/alpine-entrypoint"
  cp -a \
    "$DIR/cache/ffmpeg-musl/ffmpeg" \
    "$DIR/cache/ffmpeg-musl/ffprobe" \
    "$DIR/cache/ffmpeg-musl/LICENSE" \
    "$DIR/cache/ffmpeg-musl/LICENSE.NOTICE" \
    "$dest/build/cache/ffmpeg-musl/"
  printf '%s\n' "$dest"
}

alpine_build() {
  local ctx ver
  prepare_compose
  ensure_musl_ffmpeg
  for f in ffmpeg ffprobe LICENSE LICENSE.NOTICE; do
    if [[ ! -f "$DIR/cache/ffmpeg-musl/$f" ]]; then
      echo "error: missing $DIR/cache/ffmpeg-musl/$f" >&2
      exit 1
    fi
  done
  ctx="$(alpine_context)"
  ver="$(app_version)"
  ver="${ver:-0.0.0}"
  if ! engine build \
    -f "$DIR/Containerfile.alpine" \
    --build-arg "VERSION=$ver" \
    -t "$ALPINE_IMAGE" \
    "$ctx"
  then
    rm -rf "$ctx"
    exit 1
  fi
  rm -rf "$ctx"
}

# container_path HOST_PATH HOST_HOME
# A path under the host home is that path inside /home/servemedia.
container_path() {
  local p="$1" home="$2"
  if [[ "$p" == "$home" ]]; then
    printf '/home/servemedia\n'
  elif [[ "$p" == "$home"/* ]]; then
    printf '/home/servemedia%s\n' "${p#"$home"}"
  else
    printf '%s\n' "$p"
  fi
}

outside_home() {
  local p="$1" home="$2"
  [[ "$p" == "$home" || "$p" == "$home"/* ]] && return 1
  return 0
}

xdg_user_dir() {
  local name="$1" fallback="$2" dir
  if command -v xdg-user-dir >/dev/null 2>&1; then
    dir="$(xdg-user-dir "$name" 2>/dev/null || true)"
    if [[ -n "$dir" && "$dir" != "$HOME" && -d "$dir" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
  fi
  if [[ -d "$HOME/$fallback" ]]; then
    printf '%s\n' "$HOME/$fallback"
  fi
}

# consider_media PATH HOST_HOME — mount paths outside $HOME and record the container path.
consider_media() {
  local p="$1" home="$2" cpath
  p="${p#"${p%%[![:space:]]*}"}"
  p="${p%"${p##*[![:space:]]}"}"
  [[ -n "$p" && -d "$p" ]] || return 0
  case ",${ALPINE_SEEN}," in
    *",$p,"*) return 0 ;;
  esac
  ALPINE_SEEN="${ALPINE_SEEN:+$ALPINE_SEEN,}$p"
  cpath="$(container_path "$p" "$home")"
  if outside_home "$p" "$home"; then
    ALPINE_MOUNTS+=(-v "$p:$p")
  fi
  ALPINE_MEDIA="${ALPINE_MEDIA:+$ALPINE_MEDIA,}$cpath"
}

alpine_media_args() {
  local home="$1" part candidate
  local -a parts
  ALPINE_MOUNTS=()
  ALPINE_MEDIA=""
  ALPINE_SEEN=""
  if [[ -n "${SERVEMEDIA_MEDIA_PATH:-}" ]]; then
    IFS=',' read -r -a parts <<<"$SERVEMEDIA_MEDIA_PATH"
    for part in "${parts[@]}"; do
      consider_media "$part" "$home"
    done
    return 0
  fi
  for candidate in /mnt /media; do
    consider_media "$candidate" "$home"
  done
  candidate="$(xdg_user_dir VIDEOS Videos || true)"
  consider_media "$candidate" "$home"
  candidate="$(xdg_user_dir MUSIC Music || true)"
  consider_media "$candidate" "$home"
}

alpine_run() {
  if ! alpine_image_present; then
    echo "error: $ALPINE_IMAGE not found; pick a rebuild option" >&2
    exit 1
  fi
  local home publish name
  home="$HOME"
  publish="${SERVEMEDIA_PORT:-7676}"
  name="$(engine_name)"
  alpine_media_args "$home"
  local -a args
  args=(run --rm --name servemedia)
  if [[ -t 0 && -t 1 ]]; then
    args+=(-it)
  fi
  args+=(-p "${publish}:${publish}" -e HOME=/home/servemedia -v "$home:/home/servemedia")
  if [[ -n "${SERVEMEDIA_PORT:-}" ]]; then
    args+=(-e "SERVEMEDIA_PORT=${SERVEMEDIA_PORT}")
  fi
  if [[ -n "$ALPINE_MEDIA" ]]; then
    args+=(-e "SERVEMEDIA_MEDIA_PATH=${ALPINE_MEDIA}")
  fi
  if [[ ${#ALPINE_MOUNTS[@]} -gt 0 ]]; then
    args+=("${ALPINE_MOUNTS[@]}")
  fi
  if [[ -d /dev/dri ]]; then
    args+=(--device /dev/dri)
  fi
  if [[ "$name" == podman ]]; then
    args+=(--userns=keep-id:uid=1000,gid=1000 --security-opt label=disable)
  fi
  engine rm -f servemedia >/dev/null 2>&1 || true
  exec "$(engine_name)" "${args[@]}" "$ALPINE_IMAGE"
}

registry_logged_in() {
  local name="$1"
  if [[ "$name" == podman ]]; then
    podman login --get-login ghcr.io >/dev/null 2>&1 || return 1
    return 0
  fi
  python3 - "$HOME/.docker/config.json" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
except (OSError, json.JSONDecodeError):
    sys.exit(1)
auths = data.get("auths") or {}
sys.exit(0 if "ghcr.io" in auths or "https://ghcr.io" in auths else 1)
PY
}

ghcr_login() {
  local name token user
  name="$(engine_name)"
  if registry_logged_in "$name"; then
    return 0
  fi
  if ! command -v gh >/dev/null 2>&1; then
    echo "error: gh auth login is required; the token needs write:packages" >&2
    exit 1
  fi
  if ! token="$(gh auth token)"; then
    echo "error: gh auth login is required; the token needs write:packages" >&2
    exit 1
  fi
  if ! user="$(gh api user -q .login)"; then
    echo "error: gh auth login is required; the token needs write:packages" >&2
    exit 1
  fi
  if ! printf '%s' "$token" | engine login ghcr.io -u "$user" --password-stdin; then
    echo "error: ghcr.io login failed; the token needs write:packages" >&2
    exit 1
  fi
}

alpine_push() {
  local ver
  if ! alpine_image_present; then
    alpine_build
  fi
  ver="$(app_version)"
  ver="${ver:-0.0.0}"
  ghcr_login
  engine tag "$ALPINE_IMAGE" "$ALPINE_REMOTE:$ver"
  engine tag "$ALPINE_IMAGE" "$ALPINE_REMOTE:latest"
  if ! engine push "$ALPINE_REMOTE:$ver" || ! engine push "$ALPINE_REMOTE:latest"; then
    echo "error: push to $ALPINE_REMOTE failed; the token needs write:packages" >&2
    exit 1
  fi
}

menu() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "error: stdin/stdout must be a TTY" >&2
    exit 1
  fi
  local opts=("$@")
  local n=${#opts[@]}
  local i=0
  local key rest j
  printf '\e[?25l'
  restore() { printf '\e[?25h\e[0m'; }
  trap restore EXIT
  draw() {
    for j in "${!opts[@]}"; do
      if (( j == i )); then
        printf '\e[7m> %s\e[0m\n' "${opts[j]}"
      else
        printf '  %s\n' "${opts[j]}"
      fi
    done
  }
  draw
  while true; do
    IFS= read -rsn1 key
    rest=""
    if [[ $key == $'\e' ]]; then
      IFS= read -rsn2 -t 0.1 rest || rest=""
      key+="$rest"
    fi
    case "$key" in
      $'\e[A')
        i=$(( (i - 1 + n) % n ))
        ;;
      $'\e[B')
        i=$(( (i + 1) % n ))
        ;;
      "")
        printf '\e[%dA' "$n"
        for j in "${!opts[@]}"; do
          printf '\e[2K\n'
        done
        printf '\e[%dA' "$n"
        restore
        trap - EXIT
        CHOICE=$i
        return 0
        ;;
      *)
        continue
        ;;
    esac
    printf '\e[%dA' "$n"
    draw
  done
}

CHOICE=
menu "run" "run (webkit)" "(re)build & run" "(re)build & run (webkit)" "(re)build & package" \
  "run (container)" "(re)build & run (container)" "push (github packages)"
case "$CHOICE" in
  0)
    start
    ;;
  1)
    start --webkit
    ;;
  2)
    rebuild
    start
    ;;
  3)
    rebuild
    start --webkit
    ;;
  4)
    rebuild
    package
    ;;
  5)
    alpine_run
    ;;
  6)
    alpine_build
    alpine_run
    ;;
  7)
    alpine_push
    ;;
esac
