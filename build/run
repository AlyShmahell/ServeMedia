#!/usr/bin/env bash
# Build a host dist, then run it or pack it.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

COMPOSE_FILE="$DIR/compose.yaml"

compose() {
  if command -v podman-compose >/dev/null 2>&1; then
    podman-compose -f "$COMPOSE_FILE" "$@"
  elif command -v podman >/dev/null 2>&1 && podman compose version >/dev/null 2>&1; then
    podman compose -f "$COMPOSE_FILE" "$@"
  elif command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    docker compose -f "$COMPOSE_FILE" "$@"
  else
    echo "error: need podman-compose, podman compose, or docker compose" >&2
    exit 1
  fi
}

yaml_quote() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

path_has_glob() {
  case "$1" in
    *'*'*|*'?'*|*'['*) return 0 ;;
    *) return 1 ;;
  esac
}

# Buildah globs the context path, so a literal * in the repo path matches nothing.
prepare_compose() {
  local root dest
  root="$(cd "$DIR/.." && pwd)"
  COMPOSE_FILE="$DIR/compose.yaml"
  if ! path_has_glob "$root"; then
    return 0
  fi
  dest="${XDG_CACHE_HOME:-$HOME/.cache}/servemedia/build-context"
  rm -rf "$dest"
  mkdir -p "$dest"
  tar -C "$root" \
    --exclude=./build/cache \
    --exclude=./build/dist \
    --exclude=./build/package \
    --exclude=./.git \
    -cf - . | tar -C "$dest" -xf -
  COMPOSE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/servemedia/compose.yaml"
  cat >"$COMPOSE_FILE" <<EOF
services:
  dist:
    build:
      context: $(yaml_quote "$dest")
      dockerfile: $(yaml_quote "$dest/build/Containerfile")
    volumes:
      - $(yaml_quote "$DIR/dist:/out:z")
      - $(yaml_quote "$DIR/cache:/cache:z")
      - $(yaml_quote "$DIR/package:/package:z")
EOF
}

rebuild() {
  mkdir -p "$DIR/dist" "$DIR/cache" "$DIR/package"
  : >"$DIR/dist/.gitkeep"
  : >"$DIR/cache/.gitkeep"
  prepare_compose
  compose up --build --force-recreate --abort-on-container-exit
}

stage_package() {
  local staging="$1"
  mkdir -p "$staging/servemedia"
  cp -a "$DIR/dist"/. "$staging/servemedia/"
  rm -f "$staging/servemedia/.gitkeep"
  rm -rf "$staging/servemedia/data"
  if [[ ! -f "$staging/servemedia/LICENSE" ]]; then
    if [[ ! -f "$DIR/../LICENSE" ]]; then
      echo "error: $DIR/../LICENSE not found" >&2
      exit 1
    fi
    cp "$DIR/../LICENSE" "$staging/servemedia/LICENSE"
  fi
}

write_tar() {
  local staging="$1" name="$2"
  tar -C "$staging" -czf "$DIR/package/$name" servemedia
  echo "wrote $DIR/package/$name"
}

require_vendor_tree() {
  local root="$DIR/dist/.local/share/servemedia/vendor"
  local manifest="$DIR/../src/share/vendor.yaml"
  local missing=0 dest
  if [[ ! -f "$manifest" ]]; then
    echo "error: $manifest not found" >&2
    exit 1
  fi
  while IFS= read -r dest; do
    if [[ ! -s "$root/$dest" ]]; then
      echo "error: missing $root/$dest" >&2
      missing=1
    fi
  done < <(python3 - "$manifest" <<'PY'
import sys
path = sys.argv[1]
section = ""
cur = None
items = []

def flush():
    global cur
    if cur and cur.get("dest"):
        items.append(cur["dest"])
    cur = None

with open(path, encoding="utf-8") as f:
    for line in f:
        raw = line.rstrip("\n")
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        if raw[0] not in " \t":
            flush()
            section = raw.split(":", 1)[0].strip()
            continue
        if section != "assets":
            continue
        s = raw.strip()
        if s.startswith("- "):
            flush()
            cur = {}
            s = s[2:].strip()
            if not s:
                continue
        if cur is None or ":" not in s:
            continue
        k, _, v = s.partition(":")
        cur[k.strip()] = v.strip().strip('"').strip("'")
flush()
for dest in items:
    print(dest)
PY
)
  for dest in ffmpeg/ffmpeg ffmpeg/ffprobe; do
    if [[ ! -f "$root/$dest" ]]; then
      echo "error: missing $root/$dest" >&2
      missing=1
    fi
  done
  if [[ "$missing" -ne 0 ]]; then
    echo "error: vendor tree incomplete; rebuild dist so the builder can fetch it" >&2
    exit 1
  fi
}

package() {
  if [[ ! -x "$DIR/dist/.local/bin/servemedia" ]]; then
    echo "error: build/dist/.local/bin/servemedia not found; rebuild first" >&2
    exit 1
  fi
  mkdir -p "$DIR/package"
  : >"$DIR/package/.gitkeep"
  prepare_compose
  require_vendor_tree
  local staging

  staging="$(mktemp -d)"
  stage_package "$staging"
  local name="servemedia-linux-amd64.tar.gz"
  write_tar "$staging" "$name"
  rm -rf "$staging"
  compose run --rm dist /build/build appimage "/package/$name"
}

start() {
  if [[ ! -x "$DIR/dist/.local/bin/servemedia" ]]; then
    echo "error: build/dist/.local/bin/servemedia not found; pick a rebuild option" >&2
    exit 1
  fi
  local xdg="$DIR/cache/xdg"
  mkdir -p "$xdg/.local/bin" \
    "$xdg/.local/share/servemedia" \
    "$xdg/.local/share/applications" \
    "$xdg/.local/state" \
    "$xdg/.cache" \
    "$xdg/.config"
  rm -rf "$xdg/.local/bin/servemedia" \
    "$xdg/.local/share/servemedia" \
    "$xdg/.local/share/applications/servemedia.desktop"
  cp -a "$DIR/dist/.local/." "$xdg/.local/"
  export HOME="$xdg"
  unset XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME XDG_CONFIG_HOME SERVEMEDIA_ROOT
  exec "$xdg/.local/bin/servemedia" "$@"
}

menu() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "error: stdin/stdout must be a TTY" >&2
    exit 1
  fi
  local opts=("$@")
  local n=${#opts[@]}
  local i=0
  local key rest j
  printf '\e[?25l'
  restore() { printf '\e[?25h\e[0m'; }
  trap restore EXIT
  draw() {
    for j in "${!opts[@]}"; do
      if (( j == i )); then
        printf '\e[7m> %s\e[0m\n' "${opts[j]}"
      else
        printf '  %s\n' "${opts[j]}"
      fi
    done
  }
  draw
  while true; do
    IFS= read -rsn1 key
    rest=""
    if [[ $key == $'\e' ]]; then
      IFS= read -rsn2 -t 0.1 rest || rest=""
      key+="$rest"
    fi
    case "$key" in
      $'\e[A')
        i=$(( (i - 1 + n) % n ))
        ;;
      $'\e[B')
        i=$(( (i + 1) % n ))
        ;;
      "")
        printf '\e[%dA' "$n"
        for j in "${!opts[@]}"; do
          printf '\e[2K\n'
        done
        printf '\e[%dA' "$n"
        restore
        trap - EXIT
        CHOICE=$i
        return 0
        ;;
      *)
        continue
        ;;
    esac
    printf '\e[%dA' "$n"
    draw
  done
}

CHOICE=
menu "run" "(re)build & run" "(re)build & package"
case "$CHOICE" in
  0)
    start
    ;;
  1)
    rebuild
    start
    ;;
  2)
    rebuild
    package
    ;;
esac
