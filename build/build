#!/usr/bin/env bash
# In-image helper. Host driver is build/run (Podman).
set -euo pipefail
DIST="${DIST:-/dist}"
CACHE="${CACHE:-/cache/ffmpeg}"
OUT="${OUT:-/out}"
UA="${UA:-servemedia-builder}"

retry() { curl -fsSL -A "$UA" --retry 5 --retry-delay 2 "$@"; }

yaml_url() {
  awk -v k="$1" '
    $1 == k ":" {
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "")
      gsub(/^"/, "")
      gsub(/"[[:space:]]*$/, "")
      print
      exit
    }
  ' "$DIST/config/default.yaml"
}

yaml_section_key() {
  awk -v sec="$1" -v k="$2" '
    $1 == sec ":" { insec=1; next }
    insec && /^[^[:space:]#]/ { insec=0 }
    insec && $1 == k ":" {
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "")
      gsub(/^"/, "")
      gsub(/"[[:space:]]*$/, "")
      print
      exit
    }
  ' "$DIST/config/default.yaml"
}

yaml_version_from_text() {
  awk '
    $1 == "version:" {
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "")
      gsub(/^"/, "")
      gsub(/"[[:space:]]*$/, "")
      print
      exit
    }
  '
}

is_semver() {
  [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

matchmedia_pin() {
  local v
  v="$(yaml_section_key matchmedia version)"
  if ! is_semver "$v"; then
    echo "error: matchmedia.version must be X.Y.Z (got ${v:-empty})" >&2
    return 1
  fi
  printf '%s\n' "$v"
}

matchmedia_archive_name() {
  printf 'matchmedia-%s-linux-amd64.tar.gz\n' "$1"
}

tarball_inner_version() {
  local tarball="$1" yaml=""
  yaml="$(tar -xOf "$tarball" matchmedia/config/default.yaml 2>/dev/null || true)"
  if [[ -z "$yaml" ]]; then
    yaml="$(tar -xOf "$tarball" config/default.yaml 2>/dev/null || true)"
  fi
  printf '%s\n' "$yaml" | yaml_version_from_text
}

verify_matchmedia_archive_name() {
  local tarball="$1" pin="$2" base want
  base="$(basename "$tarball")"
  want="$(matchmedia_archive_name "$pin")"
  if [[ "$base" != "$want" ]]; then
    echo "error: cache archive $base does not match pin $want" >&2
    return 1
  fi
}

verify_matchmedia_payload() {
  local tarball="$1" pin="$2" inner
  inner="$(tarball_inner_version "$tarball")"
  if ! is_semver "$inner"; then
    echo "error: $tarball has no valid inner version (got ${inner:-empty})" >&2
    return 1
  fi
  if [[ "$inner" != "$pin" ]]; then
    echo "error: $tarball version $inner does not match matchmedia.version $pin" >&2
    return 1
  fi
}

install_matchmedia_tarball() {
  local tarball="$1"
  local tmp src
  tmp="$(mktemp -d)"
  mkdir -p "$tmp/matchmedia-extract"
  tar -xzf "$tarball" -C "$tmp/matchmedia-extract"
  src=""
  if [[ -x "$tmp/matchmedia-extract/matchmedia/matchmedia" ]]; then
    src="$tmp/matchmedia-extract/matchmedia"
  elif [[ -x "$tmp/matchmedia-extract/matchmedia" ]]; then
    src="$tmp/matchmedia-extract"
  else
    echo "error: matchmedia binary missing from tarball $tarball" >&2
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$DIST/tools/matchmedia"
  mkdir -p "$DIST/tools"
  cp -a "$src" "$DIST/tools/matchmedia"
  chmod a+x "$DIST/tools/matchmedia/matchmedia"
  rm -rf "$tmp"
}

overlay_matchmedia() {
  local cache="${MATCHMEDIA_CACHE:-/cache}" pin want matchmedia_url tmp
  local -a extras
  pin="$(matchmedia_pin)"
  want="$cache/$(matchmedia_archive_name "$pin")"
  if [[ -f "$want" ]]; then
    verify_matchmedia_archive_name "$want" "$pin"
    verify_matchmedia_payload "$want" "$pin"
    echo "using cached matchmedia $pin from $want"
    install_matchmedia_tarball "$want"
    return 0
  fi
  extras=()
  while IFS= read -r -d '' f; do
    extras+=("$f")
  done < <(find "$cache" -maxdepth 1 -type f -name 'matchmedia-*.tar.gz' -print0 2>/dev/null || true)
  if ((${#extras[@]})); then
    echo "error: matchmedia.version $pin needs $(matchmedia_archive_name "$pin"); cache has:" >&2
    printf '  %s\n' "${extras[@]}" >&2
    return 1
  fi
  matchmedia_url="$(yaml_url url)"
  if [[ "$(basename "$matchmedia_url")" != "$(matchmedia_archive_name "$pin")" ]]; then
    echo "error: matchmedia.url must end with $(matchmedia_archive_name "$pin") (got $matchmedia_url)" >&2
    return 1
  fi
  echo "fetching matchmedia $pin from $matchmedia_url"
  tmp="$(mktemp -d)"
  if retry -o "$tmp/$(matchmedia_archive_name "$pin")" "$matchmedia_url"; then
    verify_matchmedia_archive_name "$tmp/$(matchmedia_archive_name "$pin")" "$pin"
    verify_matchmedia_payload "$tmp/$(matchmedia_archive_name "$pin")" "$pin"
    install_matchmedia_tarball "$tmp/$(matchmedia_archive_name "$pin")"
    rm -rf "$tmp"
    return 0
  fi
  rm -rf "$tmp"
  echo "error: matchmedia $pin missing (place $(matchmedia_archive_name "$pin") in build/cache or set a reachable matchmedia.url)" >&2
  return 1
}

vendor() {
  local htmx_url htmx_lic videojs_js videojs_css videojs_lic hls_url hls_lic
  htmx_url="$(yaml_url htmx_url)"
  htmx_lic="$(yaml_url htmx_license_url)"
  videojs_js="$(yaml_url videojs_js_url)"
  videojs_css="$(yaml_url videojs_css_url)"
  videojs_lic="$(yaml_url videojs_license_url)"
  hls_url="$(yaml_url hls_url)"
  hls_lic="$(yaml_url hls_license_url)"
  mkdir -p "$DIST/vendor/video.js" "$DIST/vendor/ffmpeg" "$DIST/tools"
  retry -o "$DIST/vendor/htmx.min.js" "$htmx_url"
  retry -o "$DIST/vendor/htmx.min.js.LICENSE" "$htmx_lic"
  printf '%s\n' "$htmx_lic" >"$DIST/vendor/htmx.min.js.NOTICE"
  retry -o "$DIST/vendor/video.js/video.min.js" "$videojs_js"
  retry -o "$DIST/vendor/video.js/video-js.min.css" "$videojs_css"
  retry -o "$DIST/vendor/video.js/LICENSE" "$videojs_lic"
  printf '%s\n' "$videojs_lic" >"$DIST/vendor/video.js/LICENSE.NOTICE"
  retry -o "$DIST/vendor/hls.min.js" "$hls_url"
  retry -o "$DIST/vendor/hls.min.js.LICENSE" "$hls_lic"
  printf '%s\n' "$hls_lic" >"$DIST/vendor/hls.min.js.NOTICE"
}

fetch_src() {
  local dest="$1" url="$2"
  mkdir -p "$dest"
  retry -o "$dest.src" "$url"
  tar -xf "$dest.src" -C "$dest" --strip-components=1
  rm -f "$dest.src"
}

assert_host_linked_ffmpeg() {
  local bin="$1" bad
  if ! ldd "$bin" >"$bin.ldd" 2>&1; then
    echo "error: ldd failed for $bin" >&2
    cat "$bin.ldd" >&2
    return 1
  fi
  cat "$bin.ldd"
  bad="$(awk '/=>/ {print $1}' "$bin.ldd" | grep -E 'libav|libx264|libx265|libopus|libdav1d|libvpx|libmp3lame|libSvtAv1|libvpl' || true)"
  rm -f "$bin.ldd"
  if [[ -n "$bad" ]]; then
    echo "error: codec libraries must be static, found:" >&2
    printf '%s\n' "$bad" >&2
    return 1
  fi
}

compile_ffmpeg() {
  local prefix ffmpeg_lic
  prefix="${PREFIX:-/opt/ffbuild}"
  export PREFIX="$prefix"
  export PKG_CONFIG_PATH="$prefix/lib/pkgconfig:$prefix/lib64/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
  export CMAKE_POLICY_VERSION_MINIMUM=3.5
  mkdir -p "$prefix"
  local tmp
  tmp="$(mktemp -d)"
  cd "$tmp"

  fetch_src nv-codec-headers "$(yaml_url nv_codec_headers_src_url)"
  make -C nv-codec-headers PREFIX="$prefix" install

  fetch_src x264 "$(yaml_url x264_src_url)"
  (
    cd x264
    bash ./configure --prefix="$prefix" --enable-static --enable-pic --disable-cli --disable-opencl --disable-shared
    make -j"$(nproc)"
    make install
  )

  fetch_src x265 "$(yaml_url x265_src_url)"
  cmake -S x265/source -B x265/build \
    -DCMAKE_INSTALL_PREFIX="$prefix" \
    -DCMAKE_BUILD_TYPE=Release \
    -DENABLE_SHARED=OFF \
    -DENABLE_CLI=OFF \
    -DENABLE_LIBNUMA=OFF \
    -DENABLE_PIC=ON
  cmake --build x265/build -j"$(nproc)"
  cmake --install x265/build

  fetch_src opus "$(yaml_url opus_src_url)"
  (
    cd opus
    ./configure --prefix="$prefix" --disable-shared --enable-static --disable-doc --disable-extra-programs
    make -j"$(nproc)"
    make install
  )

  fetch_src dav1d "$(yaml_url dav1d_src_url)"
  meson setup dav1d/build dav1d \
    --prefix="$prefix" --buildtype=release --default-library=static \
    -Denable_tools=false -Denable_tests=false
  ninja -C dav1d/build install

  fetch_src svtav1 "$(yaml_url svtav1_src_url)"
  cmake -S svtav1 -B svtav1/build \
    -DCMAKE_INSTALL_PREFIX="$prefix" \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DBUILD_APPS=OFF \
    -DBUILD_TESTING=OFF
  cmake --build svtav1/build -j"$(nproc)"
  cmake --install svtav1/build

  fetch_src libvpx "$(yaml_url libvpx_src_url)"
  (
    cd libvpx
    ./configure --prefix="$prefix" --disable-shared --enable-static --enable-pic \
      --disable-examples --disable-tools --disable-docs --disable-unit-tests \
      --enable-vp9-highbitdepth
    make -j"$(nproc)"
    make install
  )

  fetch_src lame "$(yaml_url lame_src_url)"
  (
    cd lame
    ./configure --prefix="$prefix" --disable-shared --enable-static --disable-frontend --disable-gtktest
    make -j"$(nproc)"
    make install
  )

  fetch_src libvpl "$(yaml_url libvpl_src_url)"
  cmake -S libvpl -B libvpl/build \
    -DCMAKE_INSTALL_PREFIX="$prefix" \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DBUILD_TESTS=OFF \
    -DBUILD_TOOLS=OFF \
    -DBUILD_EXAMPLES=OFF
  cmake --build libvpl/build -j"$(nproc)"
  cmake --install libvpl/build

  fetch_src ffmpeg "$(yaml_url ffmpeg_src_url)"
  (
    cd ffmpeg
    if [[ -f "$prefix/lib/pkgconfig/vpl.pc" ]]; then
      sed -i 's/^Libs:.*/Libs: -L${libdir} -lvpl -ldl -lstdc++/' "$prefix/lib/pkgconfig/vpl.pc"
    fi
    ./configure \
      --prefix="$prefix" \
      --extra-version=hwstatic \
      --disable-debug \
      --disable-doc \
      --disable-ffplay \
      --disable-shared \
      --enable-static \
      --disable-xlib \
      --disable-libxcb \
      --disable-libxcb-shm \
      --disable-libxcb-xfixes \
      --disable-libxcb-shape \
      --disable-sdl2 \
      --disable-autodetect \
      --enable-gpl \
      --enable-version3 \
      --enable-pic \
      --enable-libx264 \
      --enable-libx265 \
      --enable-libopus \
      --enable-libdav1d \
      --enable-libsvtav1 \
      --enable-libvpx \
      --enable-libmp3lame \
      --enable-vaapi \
      --enable-libdrm \
      --enable-libvpl \
      --enable-ffnvcodec \
      --enable-nvenc \
      --enable-nvdec \
      --enable-cuvid \
      --extra-cflags="-I$prefix/include" \
      --extra-ldflags="-L$prefix/lib -L$prefix/lib64 -static-libgcc -static-libstdc++" \
      --extra-libs="-lpthread -lm -ldl -lstdc++"
    make -j"$(nproc)"
    make install
  )
  mkdir -p "$CACHE"
  cp "$prefix/bin/ffmpeg" "$prefix/bin/ffprobe" "$CACHE/"
  chmod a+x "$CACHE/ffmpeg" "$CACHE/ffprobe"
  strip "$CACHE/ffmpeg" "$CACHE/ffprobe"
  assert_host_linked_ffmpeg "$CACHE/ffmpeg"
  assert_host_linked_ffmpeg "$CACHE/ffprobe"
  ffmpeg_lic="$(yaml_url ffmpeg_license_url)"
  retry -o "$CACHE/LICENSE" "$ffmpeg_lic"
  printf '%s\n' "$ffmpeg_lic" >"$CACHE/LICENSE.NOTICE"
  cd /
  rm -rf "$tmp"
}

stage() {
  find "$OUT" -mindepth 1 -maxdepth 1 ! -name .gitkeep -exec rm -rf {} +
  mkdir -p "$CACHE" "$DIST/vendor/ffmpeg"
  if [[ -f "$CACHE/ffmpeg" && -f "$CACHE/ffprobe" && -s "$CACHE/LICENSE" ]]; then
    echo "using cached ffmpeg from $CACHE"
  else
    echo "compiling ffmpeg into $CACHE"
    compile_ffmpeg
  fi
  chmod a+x "$CACHE/ffmpeg" "$CACHE/ffprobe"
  chmod -R a+rwX /cache
  rm -rf "$DIST/vendor/ffmpeg"
  mkdir -p "$DIST/vendor/ffmpeg"
  cp -a "$CACHE"/. "$DIST/vendor/ffmpeg/"
  chmod a+x "$DIST/vendor/ffmpeg/ffmpeg" "$DIST/vendor/ffmpeg/ffprobe"
  overlay_matchmedia
  cp -a "$DIST"/. "$OUT/"
  chmod -R a+rwX "$OUT"
  chmod a+x "$OUT/servemedia"
  find "$OUT/tools" -type f -name matchmedia -exec chmod a+x {} + 2>/dev/null || true
  find "$OUT/vendor/ffmpeg" -type f \( -name ffmpeg -o -name ffprobe \) -exec chmod a+x {} +
}

appimage() {
  local tarball="${1:-}"
  if [[ -z "$tarball" || ! -f "$tarball" ]]; then
    echo "error: appimage requires the package tarball" >&2
    exit 1
  fi
  local work root qs appdir name
  work="$(mktemp -d)"
  tar -C "$work" -xzf "$tarball"
  root="$work/servemedia"
  for b in \
    "$root/servemedia" \
    "$root/vendor/ffmpeg/ffmpeg" \
    "$root/vendor/ffmpeg/ffprobe" \
    "$root/tools/matchmedia/matchmedia"
  do
    if [[ ! -f "$b" ]]; then
      echo "error: missing $b in $tarball" >&2
      exit 1
    fi
  done
  name="$(basename "$tarball" .tar.gz).AppImage"
  qs="$work/quick-sharun"
  retry -o "$qs" "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/refs/heads/main/useful-tools/quick-sharun.sh"
  chmod +x "$qs"
  appdir="$work/AppDir"
  export STRACE_MODE=0 ANYLINUX_LIB=1
  export ARCH="$(uname -m)"
  export APPDIR="$appdir"
  export OUTPATH="$(dirname "$tarball")"
  export OUTNAME="$name"
  export DESKTOP="$root/share/applications/servemedia.desktop"
  export ICON="$root/public/logo.svg"
  "$qs" \
    "$root/servemedia" \
    "$root/tools/matchmedia/matchmedia"
  mkdir -p "$appdir/servemedia"
  cp -a "$root"/. "$appdir/servemedia/"
  find "$appdir" \( -name 'libva.so*' -o -name 'libva-drm.so*' -o -name 'libdrm.so*' \) -delete
  cat >"$appdir/bin/00-servemedia-root.hook" <<'EOF'
export SERVEMEDIA_ROOT="${APPDIR}/servemedia"
EOF
  chmod +x "$appdir/bin/00-servemedia-root.hook"
  "$qs" --make-appimage
  if [[ ! -f "$OUTPATH/$name" ]]; then
    local produced
    produced="$(find "$OUTPATH" -maxdepth 1 -type f -name '*.AppImage' -print -quit)"
    if [[ -z "$produced" ]]; then
      echo "error: quick-sharun produced no AppImage" >&2
      exit 1
    fi
    mv "$produced" "$OUTPATH/$name"
  fi
  chmod a+rwx "$OUTPATH/$name"
  echo "wrote $OUTPATH/$name"
  rm -rf "$work"
}

case "${1:-}" in
  vendor) vendor ;;
  stage) stage ;;
  appimage) appimage "${2:-}" ;;
  *)
    echo "usage: $0 vendor|stage|appimage" >&2
    exit 1
    ;;
esac
