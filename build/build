#!/usr/bin/env bash
# In-image helper. Host driver is build/run (Podman).
set -euo pipefail
DIST="${DIST:-/dist}"
SHARE="${SHARE:-$DIST/.local/share/servemedia}"
CACHE="${CACHE:-/cache/ffmpeg}"
OUT="${OUT:-/out}"
UA="${UA:-servemedia-builder}"
VENDOR_YAML="${VENDOR_YAML:-/build/vendor.yaml}"

retry() { curl -fsSL -A "$UA" --retry 5 --retry-delay 2 "$@"; }

# read_vendor assets
# read_vendor source <name>
read_vendor() {
  python3 - "$VENDOR_YAML" "$@" <<'PY'
import sys
path, mode = sys.argv[1], sys.argv[2]
want_name = sys.argv[3] if len(sys.argv) > 3 else ""
section = ""
cur = None
items = []

def flush():
    global cur
    if cur and cur.get("url"):
        items.append(cur)
    cur = None

with open(path, encoding="utf-8") as f:
    for line in f:
        raw = line.rstrip("\n")
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        if raw[0] not in " \t":
            flush()
            section = raw.split(":", 1)[0].strip()
            continue
        if section != ("assets" if mode == "assets" else "sources"):
            continue
        s = raw.strip()
        if s.startswith("- "):
            flush()
            cur = {}
            s = s[2:].strip()
            if not s:
                continue
        if cur is None or ":" not in s:
            continue
        k, _, v = s.partition(":")
        cur[k.strip()] = v.strip().strip('"').strip("'")
flush()

def truthy(v):
    return v in ("true", "True", "yes")

def notice_for(dest):
    if dest.endswith(".LICENSE"):
        return dest[: -len(".LICENSE")] + ".NOTICE"
    return dest + ".NOTICE"

if mode == "assets":
    for it in items:
        dest = it.get("dest", "")
        if not dest:
            sys.exit("error: vendor asset missing dest")
        notice = notice_for(dest) if truthy(it.get("notice", "")) else ""
        print(f"{it['url']}\t{dest}\t{notice}")
elif mode == "source":
    for it in items:
        if it.get("name") == want_name:
            print(it["url"])
            raise SystemExit
    sys.exit(f"error: vendor source {want_name} missing")
else:
    sys.exit(f"error: unknown vendor mode {mode}")
PY
}

source_url() { read_vendor source "$1"; }

yaml_version_from_text() {
  awk '
    $1 == "version:" {
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "")
      gsub(/^"/, "")
      gsub(/"[[:space:]]*$/, "")
      print
      exit
    }
  '
}

vendor() {
  local url dest notice out
  mkdir -p "$SHARE/vendor"
  while IFS=$'\t' read -r url dest notice; do
    [[ -n "$url" && -n "$dest" ]] || continue
    out="$SHARE/vendor/$dest"
    mkdir -p "$(dirname "$out")"
    retry -o "$out" "$url"
    if [[ -n "$notice" ]]; then
      printf '%s\n' "$url" >"$SHARE/vendor/$notice"
    fi
  done < <(read_vendor assets)
}

fetch_src() {
  local dest="$1" url="$2"
  mkdir -p "$dest"
  retry -o "$dest.src" "$url"
  tar -xf "$dest.src" -C "$dest" --strip-components=1
  rm -f "$dest.src"
}

assert_host_linked_ffmpeg() {
  local bin="$1" bad
  if ! ldd "$bin" >"$bin.ldd" 2>&1; then
    echo "error: ldd failed for $bin" >&2
    cat "$bin.ldd" >&2
    return 1
  fi
  cat "$bin.ldd"
  bad="$(awk '/=>/ {print $1}' "$bin.ldd" | grep -E 'libav|libx264|libx265|libopus|libdav1d|libvpx|libmp3lame|libSvtAv1|libvpl' || true)"
  rm -f "$bin.ldd"
  if [[ -n "$bad" ]]; then
    echo "error: codec libraries must be static, found:" >&2
    printf '%s\n' "$bad" >&2
    return 1
  fi
}

compile_ffmpeg() {
  local prefix ffmpeg_lic
  prefix="${PREFIX:-/opt/ffbuild}"
  export PREFIX="$prefix"
  export PKG_CONFIG_PATH="$prefix/lib/pkgconfig:$prefix/lib64/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
  export CMAKE_POLICY_VERSION_MINIMUM=3.5
  mkdir -p "$prefix"
  local tmp
  tmp="$(mktemp -d)"
  cd "$tmp"

  fetch_src nv-codec-headers "$(source_url nv-codec-headers)"
  make -C nv-codec-headers PREFIX="$prefix" install

  fetch_src x264 "$(source_url x264)"
  (
    cd x264
    bash ./configure --prefix="$prefix" --enable-static --enable-pic --disable-cli --disable-opencl --disable-shared
    make -j"$(nproc)"
    make install
  )

  fetch_src x265 "$(source_url x265)"
  cmake -S x265/source -B x265/build \
    -DCMAKE_INSTALL_PREFIX="$prefix" \
    -DCMAKE_BUILD_TYPE=Release \
    -DENABLE_SHARED=OFF \
    -DENABLE_CLI=OFF \
    -DENABLE_LIBNUMA=OFF \
    -DENABLE_PIC=ON
  cmake --build x265/build -j"$(nproc)"
  cmake --install x265/build

  fetch_src opus "$(source_url opus)"
  (
    cd opus
    ./configure --prefix="$prefix" --disable-shared --enable-static --disable-doc --disable-extra-programs
    make -j"$(nproc)"
    make install
  )

  fetch_src dav1d "$(source_url dav1d)"
  meson setup dav1d/build dav1d \
    --prefix="$prefix" --buildtype=release --default-library=static \
    -Denable_tools=false -Denable_tests=false
  ninja -C dav1d/build install

  fetch_src svtav1 "$(source_url svtav1)"
  cmake -S svtav1 -B svtav1/build \
    -DCMAKE_INSTALL_PREFIX="$prefix" \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DBUILD_APPS=OFF \
    -DBUILD_TESTING=OFF
  cmake --build svtav1/build -j"$(nproc)"
  cmake --install svtav1/build

  fetch_src libvpx "$(source_url libvpx)"
  (
    cd libvpx
    ./configure --prefix="$prefix" --disable-shared --enable-static --enable-pic \
      --disable-examples --disable-tools --disable-docs --disable-unit-tests \
      --enable-vp9-highbitdepth
    make -j"$(nproc)"
    make install
  )

  fetch_src lame "$(source_url lame)"
  (
    cd lame
    ./configure --prefix="$prefix" --disable-shared --enable-static --disable-frontend --disable-gtktest
    make -j"$(nproc)"
    make install
  )

  fetch_src libvpl "$(source_url libvpl)"
  cmake -S libvpl -B libvpl/build \
    -DCMAKE_INSTALL_PREFIX="$prefix" \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DBUILD_TESTS=OFF \
    -DBUILD_TOOLS=OFF \
    -DBUILD_EXAMPLES=OFF
  cmake --build libvpl/build -j"$(nproc)"
  cmake --install libvpl/build

  fetch_src ffmpeg "$(source_url ffmpeg)"
  (
    cd ffmpeg
    if [[ -f "$prefix/lib/pkgconfig/vpl.pc" ]]; then
      sed -i 's/^Libs:.*/Libs: -L${libdir} -lvpl -ldl -lstdc++/' "$prefix/lib/pkgconfig/vpl.pc"
    fi
    ./configure \
      --prefix="$prefix" \
      --extra-version=hwstatic \
      --disable-debug \
      --disable-doc \
      --disable-ffplay \
      --disable-shared \
      --enable-static \
      --disable-xlib \
      --disable-libxcb \
      --disable-libxcb-shm \
      --disable-libxcb-xfixes \
      --disable-libxcb-shape \
      --disable-sdl2 \
      --disable-autodetect \
      --enable-gpl \
      --enable-version3 \
      --enable-pic \
      --enable-libx264 \
      --enable-libx265 \
      --enable-libopus \
      --enable-libdav1d \
      --enable-libsvtav1 \
      --enable-libvpx \
      --enable-libmp3lame \
      --enable-vaapi \
      --enable-libdrm \
      --enable-libvpl \
      --enable-ffnvcodec \
      --enable-nvenc \
      --enable-nvdec \
      --enable-cuvid \
      --extra-cflags="-I$prefix/include" \
      --extra-ldflags="-L$prefix/lib -L$prefix/lib64 -static-libgcc -static-libstdc++" \
      --extra-libs="-lpthread -lm -ldl -lstdc++"
    make -j"$(nproc)"
    make install
  )
  mkdir -p "$CACHE"
  cp "$prefix/bin/ffmpeg" "$prefix/bin/ffprobe" "$CACHE/"
  chmod a+x "$CACHE/ffmpeg" "$CACHE/ffprobe"
  strip "$CACHE/ffmpeg" "$CACHE/ffprobe"
  assert_host_linked_ffmpeg "$CACHE/ffmpeg"
  assert_host_linked_ffmpeg "$CACHE/ffprobe"
  ffmpeg_lic="$(source_url ffmpeg-license)"
  retry -o "$CACHE/LICENSE" "$ffmpeg_lic"
  printf '%s\n' "$ffmpeg_lic" >"$CACHE/LICENSE.NOTICE"
  cd /
  rm -rf "$tmp"
}

stage() {
  find "$OUT" -mindepth 1 -maxdepth 1 ! -name .gitkeep -exec rm -rf {} +
  mkdir -p "$CACHE" "$SHARE/vendor/ffmpeg"
  if [[ -f "$CACHE/ffmpeg" && -f "$CACHE/ffprobe" && -s "$CACHE/LICENSE" ]]; then
    echo "using cached ffmpeg from $CACHE"
  else
    echo "compiling ffmpeg into $CACHE"
    compile_ffmpeg
  fi
  chmod a+x "$CACHE/ffmpeg" "$CACHE/ffprobe"
  chmod -R a+rwX /cache
  rm -rf "$SHARE/vendor/ffmpeg"
  mkdir -p "$SHARE/vendor/ffmpeg"
  cp -a "$CACHE"/. "$SHARE/vendor/ffmpeg/"
  chmod a+x "$SHARE/vendor/ffmpeg/ffmpeg" "$SHARE/vendor/ffmpeg/ffprobe"
  cp -a "$DIST"/. "$OUT/"
  chmod -R a+rwX "$OUT"
  chmod a+x "$OUT/.local/bin/servemedia"
  find "$OUT/.local/share/servemedia/vendor/ffmpeg" -type f \( -name ffmpeg -o -name ffprobe \) -exec chmod a+x {} +
}

appimage() {
  local tarball="${1:-}"
  if [[ -z "$tarball" || ! -f "$tarball" ]]; then
    echo "error: appimage requires the package tarball" >&2
    exit 1
  fi
  local work root share qs appdir name
  work="$(mktemp -d)"
  tar -C "$work" -xzf "$tarball"
  root="$work/servemedia"
  share="$root/.local/share/servemedia"
  for b in \
    "$root/.local/bin/servemedia" \
    "$share/vendor/ffmpeg/ffmpeg" \
    "$share/vendor/ffmpeg/ffprobe"
  do
    if [[ ! -f "$b" ]]; then
      echo "error: missing $b in $tarball" >&2
      exit 1
    fi
  done
  name="servemedia-linux-amd64.AppImage"
  local version
  version="$(yaml_version_from_text < "$share/config/default.yaml")"
  version="${version:-0.0.0}"
  qs="$work/quick-sharun"
  retry -o "$qs" "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/refs/heads/main/useful-tools/quick-sharun.sh"
  chmod +x "$qs"
  appdir="$work/AppDir"
  export STRACE_MODE=0 ANYLINUX_LIB=1
  export ARCH="$(uname -m)"
  export APPDIR="$appdir"
  export OUTPATH="$(dirname "$tarball")"
  export OUTNAME="$name"
  export DESKTOP="$root/.local/share/applications/servemedia.desktop"
  export ICON="$share/public/logo.svg"
  export VERSION="$version"
  export STARTUPWMCLASS=eu.alyshmahell.ServeMedia
  export UPINFO="gh-releases-zsync|AlyShmahell|servemedia|latest|servemedia-linux-amd64.AppImage.zsync"
  "$qs" \
    "$root/.local/bin/servemedia"
  mkdir -p "$appdir/servemedia"
  cp -a "$root"/. "$appdir/servemedia/"
  find "$appdir" \( -name 'libva.so*' -o -name 'libva-drm.so*' -o -name 'libdrm.so*' \) -delete
  cat >"$appdir/bin/00-servemedia-root.hook" <<'EOF'
export SERVEMEDIA_ROOT="${APPDIR}/servemedia/.local/share/servemedia"
if [ -z "${SERVEMEDIA_LAUNCHED:-}" ]; then
  export SERVEMEDIA_LAUNCHED=1
  exec "${APPDIR}/servemedia/.local/bin/servemedia" "$@"
fi
EOF
  chmod +x "$appdir/bin/00-servemedia-root.hook"
  "$qs" --make-appimage
  if [[ ! -f "$OUTPATH/$name" ]]; then
    local produced
    produced="$(find "$OUTPATH" -maxdepth 1 -type f -name '*.AppImage' -print -quit)"
    if [[ -z "$produced" ]]; then
      echo "error: quick-sharun produced no AppImage" >&2
      exit 1
    fi
    mv "$produced" "$OUTPATH/$name"
  fi
  chmod a+rwx "$OUTPATH/$name"
  echo "wrote $OUTPATH/$name"
  rm -rf "$work"
}

case "${1:-}" in
  vendor) vendor ;;
  stage) stage ;;
  appimage) appimage "${2:-}" ;;
  *)
    echo "usage: $0 vendor|stage|appimage" >&2
    exit 1
    ;;
esac
