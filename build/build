#!/usr/bin/env bash
# In-image helper. Host driver is build/run (Podman).
set -euo pipefail
DIST="${DIST:-/dist}"
CACHE="${CACHE:-/cache/ffmpeg}"
OUT="${OUT:-/out}"
UA="${UA:-servemedia-builder}"

retry() { curl -fsSL -A "$UA" --retry 5 --retry-delay 2 "$@"; }

yaml_url() {
  awk -v k="$1" '
    $1 == k ":" {
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "")
      gsub(/^"/, "")
      gsub(/"[[:space:]]*$/, "")
      print
      exit
    }
  ' "$DIST/config/default.yaml"
}

yaml_section_key() {
  awk -v sec="$1" -v k="$2" '
    $1 == sec ":" { insec=1; next }
    insec && /^[^[:space:]#]/ { insec=0 }
    insec && $1 == k ":" {
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "")
      gsub(/^"/, "")
      gsub(/"[[:space:]]*$/, "")
      print
      exit
    }
  ' "$DIST/config/default.yaml"
}

yaml_version_from_text() {
  awk '
    $1 == "version:" {
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "")
      gsub(/^"/, "")
      gsub(/"[[:space:]]*$/, "")
      print
      exit
    }
  '
}

is_semver() {
  [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

matchmedia_pin() {
  local v
  v="$(yaml_section_key matchmedia version)"
  if ! is_semver "$v"; then
    echo "error: matchmedia.version must be X.Y.Z (got ${v:-empty})" >&2
    return 1
  fi
  printf '%s\n' "$v"
}

matchmedia_archive_name() {
  printf 'matchmedia-%s-linux-amd64.tar.gz\n' "$1"
}

tarball_inner_version() {
  local tarball="$1" yaml=""
  yaml="$(tar -xOf "$tarball" matchmedia/config/default.yaml 2>/dev/null || true)"
  if [[ -z "$yaml" ]]; then
    yaml="$(tar -xOf "$tarball" config/default.yaml 2>/dev/null || true)"
  fi
  printf '%s\n' "$yaml" | yaml_version_from_text
}

verify_matchmedia_archive_name() {
  local tarball="$1" pin="$2" base want
  base="$(basename "$tarball")"
  want="$(matchmedia_archive_name "$pin")"
  if [[ "$base" != "$want" ]]; then
    echo "error: cache archive $base does not match pin $want" >&2
    return 1
  fi
}

verify_matchmedia_payload() {
  local tarball="$1" pin="$2" inner
  inner="$(tarball_inner_version "$tarball")"
  if ! is_semver "$inner"; then
    echo "error: $tarball has no valid inner version (got ${inner:-empty})" >&2
    return 1
  fi
  if [[ "$inner" != "$pin" ]]; then
    echo "error: $tarball version $inner does not match matchmedia.version $pin" >&2
    return 1
  fi
}

install_matchmedia_tarball() {
  local tarball="$1"
  local tmp src
  tmp="$(mktemp -d)"
  mkdir -p "$tmp/matchmedia-extract"
  tar -xzf "$tarball" -C "$tmp/matchmedia-extract"
  src=""
  if [[ -x "$tmp/matchmedia-extract/matchmedia/matchmedia" ]]; then
    src="$tmp/matchmedia-extract/matchmedia"
  elif [[ -x "$tmp/matchmedia-extract/matchmedia" ]]; then
    src="$tmp/matchmedia-extract"
  else
    echo "error: matchmedia binary missing from tarball $tarball" >&2
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$DIST/tools/matchmedia"
  mkdir -p "$DIST/tools"
  cp -a "$src" "$DIST/tools/matchmedia"
  chmod a+x "$DIST/tools/matchmedia/matchmedia"
  rm -rf "$tmp"
}

overlay_matchmedia() {
  local cache="${MATCHMEDIA_CACHE:-/cache}" pin want matchmedia_url tmp
  local -a extras
  pin="$(matchmedia_pin)"
  want="$cache/$(matchmedia_archive_name "$pin")"
  if [[ -f "$want" ]]; then
    verify_matchmedia_archive_name "$want" "$pin"
    verify_matchmedia_payload "$want" "$pin"
    echo "using cached matchmedia $pin from $want"
    install_matchmedia_tarball "$want"
    return 0
  fi
  extras=()
  while IFS= read -r -d '' f; do
    extras+=("$f")
  done < <(find "$cache" -maxdepth 1 -type f -name 'matchmedia-*.tar.gz' -print0 2>/dev/null || true)
  if ((${#extras[@]})); then
    echo "error: matchmedia.version $pin needs $(matchmedia_archive_name "$pin"); cache has:" >&2
    printf '  %s\n' "${extras[@]}" >&2
    return 1
  fi
  matchmedia_url="$(yaml_url url)"
  if [[ "$(basename "$matchmedia_url")" != "$(matchmedia_archive_name "$pin")" ]]; then
    echo "error: matchmedia.url must end with $(matchmedia_archive_name "$pin") (got $matchmedia_url)" >&2
    return 1
  fi
  echo "fetching matchmedia $pin from $matchmedia_url"
  tmp="$(mktemp -d)"
  if retry -o "$tmp/$(matchmedia_archive_name "$pin")" "$matchmedia_url"; then
    verify_matchmedia_archive_name "$tmp/$(matchmedia_archive_name "$pin")" "$pin"
    verify_matchmedia_payload "$tmp/$(matchmedia_archive_name "$pin")" "$pin"
    install_matchmedia_tarball "$tmp/$(matchmedia_archive_name "$pin")"
    rm -rf "$tmp"
    return 0
  fi
  rm -rf "$tmp"
  echo "error: matchmedia $pin missing (place $(matchmedia_archive_name "$pin") in build/cache or set a reachable matchmedia.url)" >&2
  return 1
}

vendor() {
  local htmx_url htmx_lic videojs_js videojs_css videojs_lic hls_url hls_lic
  htmx_url="$(yaml_url htmx_url)"
  htmx_lic="$(yaml_url htmx_license_url)"
  videojs_js="$(yaml_url videojs_js_url)"
  videojs_css="$(yaml_url videojs_css_url)"
  videojs_lic="$(yaml_url videojs_license_url)"
  hls_url="$(yaml_url hls_url)"
  hls_lic="$(yaml_url hls_license_url)"
  mkdir -p "$DIST/vendor/video.js" "$DIST/vendor/ffmpeg" "$DIST/tools"
  retry -o "$DIST/vendor/htmx.min.js" "$htmx_url"
  retry -o "$DIST/vendor/htmx.min.js.LICENSE" "$htmx_lic"
  printf '%s\n' "$htmx_lic" >"$DIST/vendor/htmx.min.js.NOTICE"
  retry -o "$DIST/vendor/video.js/video.min.js" "$videojs_js"
  retry -o "$DIST/vendor/video.js/video-js.min.css" "$videojs_css"
  retry -o "$DIST/vendor/video.js/LICENSE" "$videojs_lic"
  printf '%s\n' "$videojs_lic" >"$DIST/vendor/video.js/LICENSE.NOTICE"
  retry -o "$DIST/vendor/hls.min.js" "$hls_url"
  retry -o "$DIST/vendor/hls.min.js.LICENSE" "$hls_lic"
  printf '%s\n' "$hls_lic" >"$DIST/vendor/hls.min.js.NOTICE"
}

compile_ffmpeg() {
  local prefix x264_prefix ffmpeg_src x264_src tmp ffmpeg_lic
  prefix="${PREFIX:-/opt/ffmpeg}"
  x264_prefix="${X264_PREFIX:-/opt/x264}"
  ffmpeg_src="$(yaml_url ffmpeg_src_url)"
  x264_src="$(yaml_url x264_src_url)"
  tmp="$(mktemp -d)"
  retry -o "$tmp/x264.src" "$x264_src"
  mkdir -p "$tmp/x264-src"
  tar -xf "$tmp/x264.src" -C "$tmp/x264-src" --strip-components=1
  (
    cd "$tmp/x264-src"
    bash ./configure --prefix="$x264_prefix" --enable-static --disable-shared --disable-cli
    make -j"$(nproc)"
    make install
  )
  retry -o "$tmp/ffmpeg.src" "$ffmpeg_src"
  mkdir -p "$tmp/ffmpeg-src"
  tar -xf "$tmp/ffmpeg.src" -C "$tmp/ffmpeg-src" --strip-components=1
  (
    cd "$tmp/ffmpeg-src"
    export PKG_CONFIG_PATH="$x264_prefix/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    ./configure \
      --prefix="$prefix" \
      --enable-gpl \
      --enable-version3 \
      --enable-libx264 \
      --enable-vaapi \
      --enable-libdrm \
      --enable-static \
      --disable-shared \
      --disable-debug \
      --disable-doc \
      --disable-ffplay \
      --extra-cflags="-I$x264_prefix/include" \
      --extra-ldflags="-L$x264_prefix/lib"
    make -j"$(nproc)"
    make install
  )
  rm -rf "$tmp"
  cp /opt/ffmpeg/bin/ffmpeg /opt/ffmpeg/bin/ffprobe "$CACHE/"
  ffmpeg_lic="$(yaml_url ffmpeg_license_url)"
  retry -o "$CACHE/LICENSE" "$ffmpeg_lic"
  printf '%s\n' "$ffmpeg_lic" >"$CACHE/LICENSE.NOTICE"
}

stage() {
  find "$OUT" -mindepth 1 -maxdepth 1 ! -name .gitkeep -exec rm -rf {} +
  mkdir -p "$CACHE" "$DIST/vendor/ffmpeg"
  if [[ -f "$CACHE/ffmpeg" && -f "$CACHE/ffprobe" && -s "$CACHE/LICENSE" ]]; then
    echo "using cached ffmpeg from $CACHE"
  else
    echo "compiling ffmpeg into $CACHE"
    compile_ffmpeg
  fi
  chmod a+x "$CACHE/ffmpeg" "$CACHE/ffprobe"
  chmod -R a+rwX /cache
  rm -rf "$DIST/vendor/ffmpeg"
  mkdir -p "$DIST/vendor/ffmpeg"
  cp -a "$CACHE"/. "$DIST/vendor/ffmpeg/"
  chmod a+x "$DIST/vendor/ffmpeg/ffmpeg" "$DIST/vendor/ffmpeg/ffprobe"
  overlay_matchmedia
  cp -a "$DIST"/. "$OUT/"
  chmod -R a+rwX "$OUT"
  chmod a+x "$OUT/servemedia"
  find "$OUT/tools" -type f -name matchmedia -exec chmod a+x {} + 2>/dev/null || true
  find "$OUT/vendor/ffmpeg" -type f \( -name ffmpeg -o -name ffprobe \) -exec chmod a+x {} +
}

case "${1:-}" in
  vendor) vendor ;;
  stage) stage ;;
  *)
    echo "usage: $0 vendor|stage" >&2
    exit 1
    ;;
esac
