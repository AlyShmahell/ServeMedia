#!/usr/bin/env bash
# TTY menu: online | offline pipelines.
# Each runs: resync → regen → lint → build → package → install.
# Host: Podman. IN_CONTAINER=1: work inside the Fedora or golang image.
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
BUILD="$ROOT/build"
PINS="$DIR/pins"
DEFAULT_YAML="$ROOT/src/share/config/default.yaml"
VENDOR_YAML="$ROOT/src/share/vendor.yaml"
APP_ID="eu.alyshmahell.ServeMedia"
YML="$DIR/${APP_ID}.yml"
META="$DIR/${APP_ID}.metainfo.xml"
IMAGE="localhost/servemedia-flatpak-builder:latest"
RUNTIME_VER="26.08"
SM_REPO="${SERVEMEDIA_REPO:-AlyShmahell/ServeMedia}"
UA="servemedia-flatpak-sync"

need_podman() {
  if ! command -v podman >/dev/null 2>&1; then
    echo "error: podman is required" >&2
    exit 1
  fi
}

need_flatpak() {
  if ! command -v flatpak >/dev/null 2>&1; then
    echo "error: flatpak is required to install the bundle" >&2
    exit 1
  fi
}

network_up() {
  curl -fsI --connect-timeout 3 --max-time 5 \
    https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1
}

yaml_version() {
  python3 -c '
import pathlib, re, sys
text = pathlib.Path(sys.argv[1]).read_text()
m = re.search(r"^version:\s*\"?([^\"\n]+)\"?", text, re.M)
print(m.group(1).strip() if m else "0.0.0")
' "$DEFAULT_YAML"
}

app_version() {
  if [[ "${PIPELINE:-}" == offline ]]; then
    yaml_version
    return
  fi
  python3 -c '
import pathlib, re, sys
meta = pathlib.Path(sys.argv[1]).read_text()
m = re.search(r"<release version=\"([^\"]+)\"", meta)
print(m.group(1) if m else "0.0.0")
' "$META"
}

yml_git_tag() {
  python3 -c '
import pathlib, re, sys
yml, url = pathlib.Path(sys.argv[1]).read_text(), sys.argv[2]
m = re.search(rf"url: {re.escape(url)}\n        tag: (v[\d.]+)\n", yml)
print(m.group(1) if m else "")
' "$YML" "$1"
}

yml_git_commit() {
  python3 -c '
import pathlib, re, sys
yml, url = pathlib.Path(sys.argv[1]).read_text(), sys.argv[2]
m = re.search(
    rf"url: {re.escape(url)}\n        tag: v[\d.]+\n        commit: ([0-9a-f]+)\n",
    yml,
)
print(m.group(1) if m else "")
' "$YML" "$1"
}

parse_version_yaml() {
  python3 -c '
import sys
ver = ""
for line in open(sys.argv[1], encoding="utf-8"):
    raw = line.rstrip("\n")
    s = raw.strip()
    if s.startswith("version:") and raw[:1] not in (" ", "\t"):
        ver = s.split(":", 1)[1].strip().strip("\"")
        break
if not ver:
    sys.exit(2)
print("VER=" + repr(ver))
' "$1"
}

parse_vendor_yaml() {
  python3 - "$1" <<'PY'
import sys
path = sys.argv[1]
dest_env = {
    "htmx.min.js": "HTMX_URL",
    "htmx.min.js.LICENSE": "HTMX_LICENSE_URL",
    "video.js/video.min.js": "VIDEOJS_JS_URL",
    "video.js/video-js.min.css": "VIDEOJS_CSS_URL",
    "video.js/LICENSE": "VIDEOJS_LICENSE_URL",
    "hls.min.js": "HLS_URL",
    "hls.min.js.LICENSE": "HLS_LICENSE_URL",
    "codemirror/codemirror.min.js": "CODEMIRROR_JS_URL",
    "codemirror/codemirror.min.css": "CODEMIRROR_CSS_URL",
    "codemirror/yaml.min.js": "CODEMIRROR_YAML_URL",
    "codemirror/LICENSE": "CODEMIRROR_LICENSE_URL",
}
section = ""
cur = None
urls = {}

def flush():
    global cur
    if cur and cur.get("dest") and cur.get("url"):
        urls[cur["dest"]] = cur["url"]
    cur = None

with open(path, encoding="utf-8") as f:
    for line in f:
        raw = line.rstrip("\n")
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        if raw[0] not in " \t":
            flush()
            section = raw.split(":", 1)[0].strip()
            continue
        if section != "assets":
            continue
        s = raw.strip()
        if s.startswith("- "):
            flush()
            cur = {}
            s = s[2:].strip()
            if not s:
                continue
        if cur is None or ":" not in s:
            continue
        k, _, v = s.partition(":")
        cur[k.strip()] = v.strip().strip('"').strip("'")
flush()
missing = [d for d in dest_env if d not in urls]
if missing:
    sys.exit(2)
for dest, env in dest_env.items():
    print(env + "=" + repr(urls[dest]))
PY
}

rewrite_go_sources_path() {
  awk -v dest="$2" '
    $0 == "  path: modules.txt" { print "  dest-filename: modules.txt"; print "  path: " dest; next }
    { print }
  ' "$1" >"$3"
}

rewrite_modules_to_url() {
  local go_mod_yml="$1" out="$2" dest_pref="$3" url="$4" sha="$5"
  python3 - "$go_mod_yml" "$out" "$dest_pref" "$url" "$sha" <<'PY'
import pathlib, re, sys
src, out, dest_pref, url, sha = sys.argv[1:6]
text = pathlib.Path(src).read_text()
patterns = [
    (
        rf"(?ms)^(- dest: {re.escape(dest_pref)}vendor\n)(?:  dest-filename: modules\.txt\n)?  path: modules\.txt\n(  type: file\n)",
        rf"\1  dest-filename: modules.txt\n  url: {url}\n  sha256: {sha}\n\2",
    ),
    (
        rf"(?ms)^(- dest: {re.escape(dest_pref)}vendor\n  dest-filename: modules\.txt\n)  path: .+\n(  type: file\n)",
        rf"\1  url: {url}\n  sha256: {sha}\n\2",
    ),
]
n = 0
text2 = text
for pat, repl in patterns:
    text2, n = re.subn(pat, repl, text, count=1)
    if n == 1:
        break
if n != 1:
    sys.exit(f"error: rewrite {dest_pref}modules.txt source failed")
pathlib.Path(out).write_text(text2)
PY
}

prepare_work() {
  local src="${SRC:-/src}" work="${WORK:-$CACHE/work}"
  local mode="${PREPARE_MODE:-online}"
  rm -rf "$work"
  mkdir -p "$work/pins"
  cp "$src/flatpak/${APP_ID}.yml" "$work/"
  cp "$src/flatpak/${APP_ID}.metainfo.xml" "$work/"
  cp "$src/flatpak/pins/"*.yml "$work/pins/"
  cp "$src/flatpak/pins/"*.txt "$work/pins/"
  if [[ "$mode" == offline ]]; then
    mkdir -p "$work/local-src"
    cp -a "$src/src" "$work/local-src/"
    cp -a "$src/flatpak" "$work/local-src/"
    cp -a "$src/LICENSE" "$work/local-src/"
    python3 - "$work/$APP_ID.yml" <<'PY'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1])
yml = path.read_text()
block = re.compile(
    r"(?ms)(  - name: servemedia\n.*?    sources:\n)"
    r"      - type: git\n"
    r"        url: https://github.com/AlyShmahell/ServeMedia\.git\n"
    r"        tag: v[\d.]+\n"
    r"        commit: [0-9a-f]+\n"
    r"        x-checker-data:\n"
    r"          type: git\n"
    r"          tag-pattern: \^v\(\[\\d\.\]\+\)\$\n"
)
repl = (
    r"\1"
    r"      - type: dir\n"
    r"        path: local-src\n"
)
out, n = block.subn(repl, yml, count=1)
if n != 1:
    sys.exit("error: could not rewrite ServeMedia source to type: dir")
path.write_text(out)
PY
  fi
  if [[ ! -f "$work/$APP_ID.yml" ]]; then
    echo "error: flatpak manifest missing in $work" >&2
    exit 1
  fi
}

ref_installed() {
  flatpak --user info "$1" >/dev/null 2>&1
}

ensure_runtimes() {
  local offline="${1:-}"
  local plat="org.freedesktop.Platform//${RUNTIME_VER}"
  local sdk="org.freedesktop.Sdk//${RUNTIME_VER}"
  local golang="org.freedesktop.Sdk.Extension.golang//${RUNTIME_VER}"
  if [[ -n "$offline" ]]; then
    if ! ref_installed "$plat" || ! ref_installed "$sdk" || ! ref_installed "$golang"; then
      echo "error: Freedesktop ${RUNTIME_VER} Platform/SDK or golang extension missing from cache" >&2
      exit 1
    fi
    return 0
  fi
  flatpak --user remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  flatpak --user install -y --noninteractive flathub "$plat" "$sdk" "$golang"
}

ensure_linter() {
  local offline="${1:-}"
  if ref_installed org.flatpak.Builder; then
    return 0
  fi
  if [[ -n "$offline" ]]; then
    echo "error: org.flatpak.Builder missing from cache" >&2
    exit 1
  fi
  flatpak --user remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  flatpak --user install -y --noninteractive flathub org.flatpak.Builder
}

inner_build() {
  local offline="${1:-}"
  local mode="${PREPARE_MODE:-online}"
  local cache="${CACHE:-/cache}"
  local work="${WORK:-$cache/work}"
  local repo builddir

  export FLATPAK_USER_DIR="${cache}/user"
  export XDG_CACHE_HOME="${cache}/xdg"
  mkdir -p "$FLATPAK_USER_DIR" "$XDG_CACHE_HOME"
  PREPARE_MODE="$mode" prepare_work
  ensure_runtimes "$offline"
  if [[ -z "$offline" ]]; then
    ensure_linter ""
  fi

  repo="$work/repo"
  builddir="$work/build"
  rm -rf "$repo" "$builddir"
  mkdir -p "$repo"
  cd "$work"
  if [[ -n "$offline" ]]; then
    flatpak-builder \
      --user \
      --offline \
      --disable-rofiles-fuse \
      --state-dir "${cache}/builder" \
      --repo "$repo" \
      --force-clean \
      "$builddir" \
      "$work/$APP_ID.yml"
  else
    flatpak-builder \
      --user \
      --disable-rofiles-fuse \
      --state-dir "${cache}/builder" \
      --repo "$repo" \
      --force-clean \
      "$builddir" \
      "$work/$APP_ID.yml"
  fi
  chmod -R a+rwX "$cache" || true
  echo "built repo $repo"
}

inner_package() {
  local offline="${1:-}"
  local cache="${CACHE:-/cache}"
  local out="${OUT:-/out}"
  local work="${WORK:-$cache/work}"
  local repo dest

  export FLATPAK_USER_DIR="${cache}/user"
  export XDG_CACHE_HOME="${cache}/xdg"
  repo="$work/repo"
  if [[ ! -d "$repo" ]]; then
    echo "error: builder repo missing; run build first" >&2
    exit 1
  fi
  mkdir -p "$out"
  dest="$out/servemedia-linux-amd64.flatpak"
  if [[ -n "$offline" ]]; then
    flatpak build-bundle "$repo" "$dest" "$APP_ID"
  else
    flatpak build-bundle \
      "$repo" \
      "$dest" \
      "$APP_ID" \
      --runtime-repo=https://dl.flathub.org/repo/flathub.flatpakrepo
  fi
  echo "wrote $dest"
  chmod -R a+rwX "$out" "$cache" || true
}

inner_lint() {
  local offline="${1:-}"
  local mode="${PREPARE_MODE:-online}"
  local cache="${CACHE:-/cache}"
  local work="${WORK:-$cache/work}"
  export FLATPAK_USER_DIR="${cache}/user"
  export XDG_CACHE_HOME="${cache}/xdg"
  mkdir -p "$FLATPAK_USER_DIR" "$XDG_CACHE_HOME"
  PREPARE_MODE="$mode" prepare_work
  ensure_linter "$offline"
  cd "$work"
  flatpak run --command=flatpak-builder-lint org.flatpak.Builder manifest "$work/$APP_ID.yml"
}

inner_regen() {
  local src="${SRC:-/src}"
  local pin_mode="${PIN_MODE:-path}"
  local work sm_src sm_tag sm_commit
  work="$(mktemp -d)"
  trap 'rm -rf "'"$work"'"' EXIT
  sm_tag="${SERVEMEDIA_TAG:-}"
  sm_commit="${SERVEMEDIA_COMMIT:-}"

  if [[ -n "$sm_tag" ]]; then
    git clone --depth 1 --branch "$sm_tag" "https://github.com/${SM_REPO}.git" "$work/servemedia-src"
  else
    mkdir -p "$work/servemedia-src"
    cp -a "${src}/src" "$work/servemedia-src/src"
  fi
  sm_src="$work/servemedia-src/src"
  rm -rf "$sm_src/vendor"

  export GOFLAGS=-buildvcs=false
  export GOPROXY=https://proxy.golang.org,direct
  mkdir -p "$work/sm" "${src}/flatpak/pins"
  go run github.com/dennwc/flatpak-go-mod@latest \
    -dest-pref src/ \
    -out "$work/sm" \
    "$sm_src"

  install -m644 "$work/sm/modules.txt" "${src}/flatpak/pins/servemedia.modules.txt"

  if [[ "$pin_mode" == url ]]; then
    if [[ -z "$sm_commit" ]]; then
      echo "error: SERVEMEDIA_COMMIT required for URL pin mode" >&2
      exit 1
    fi
    local sm_url sm_sha
    sm_url="https://raw.githubusercontent.com/${SM_REPO}/${sm_commit}/flatpak/pins/servemedia.modules.txt"
    sm_sha="$(sha256sum "${src}/flatpak/pins/servemedia.modules.txt" | awk '{print $1}')"
    rewrite_modules_to_url "$work/sm/go.mod.yml" \
      "${src}/flatpak/pins/servemedia-go-sources.yml" "src/" "$sm_url" "$sm_sha"
  else
    rewrite_go_sources_path "$work/sm/go.mod.yml" pins/servemedia.modules.txt \
      "${src}/flatpak/pins/servemedia-go-sources.yml"
  fi
  echo "wrote ${src}/flatpak/pins (mode=$pin_mode)"
}

if [[ "${IN_CONTAINER:-}" == 1 ]]; then
  case "${ACTION:-}" in
    build) PREPARE_MODE="${PREPARE_MODE:-online}" inner_build "" ;;
    build-offline) PREPARE_MODE="${PREPARE_MODE:-offline}" inner_build offline ;;
    package) inner_package "" ;;
    package-offline) inner_package offline ;;
    lint) PREPARE_MODE="${PREPARE_MODE:-online}" inner_lint "" ;;
    lint-offline) PREPARE_MODE="${PREPARE_MODE:-offline}" inner_lint offline ;;
    regen) inner_regen ;;
    *)
      echo "error: unknown ACTION ${ACTION:-}" >&2
      exit 1
      ;;
  esac
  exit 0
fi

menu() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "error: stdin/stdout must be a TTY" >&2
    exit 1
  fi
  local opts=("$@")
  local n=${#opts[@]}
  local i=0
  local key rest j
  printf '\e[?25l'
  restore() { printf '\e[?25h\e[0m'; }
  trap restore EXIT
  draw() {
    for j in "${!opts[@]}"; do
      if (( j == i )); then
        printf '\e[7m> %s\e[0m\n' "${opts[j]}"
      else
        printf '  %s\n' "${opts[j]}"
      fi
    done
  }
  draw
  while true; do
    IFS= read -rsn1 key
    rest=""
    if [[ $key == $'\e' ]]; then
      IFS= read -rsn2 -t 0.1 rest || rest=""
      key+="$rest"
    fi
    case "$key" in
      $'\e[A')
        i=$(( (i - 1 + n) % n ))
        ;;
      $'\e[B')
        i=$(( (i + 1) % n ))
        ;;
      "")
        printf '\e[%dA' "$n"
        for j in "${!opts[@]}"; do
          printf '\e[2K\n'
        done
        printf '\e[%dA' "$n"
        restore
        trap - EXIT
        CHOICE=$i
        return 0
        ;;
      *)
        continue
        ;;
    esac
    printf '\e[%dA' "$n"
    draw
  done
}

path_has_glob() {
  case "$1" in
    *'*'*|*'?'*|*'['*) return 0 ;;
    *) return 1 ;;
  esac
}

# Buildah globs the context path, so a literal * in the repo path matches nothing.
glob_free_context() {
  local src="$1" dest="$2"
  if ! path_has_glob "$src"; then
    printf '%s\n' "$src"
    return 0
  fi
  rm -rf "$dest"
  mkdir -p "$dest"
  tar -C "$src" -cf - . | tar -C "$dest" -xf -
  printf '%s\n' "$dest"
}

ensure_builder_image() {
  local ctx
  ctx="$(glob_free_context "$DIR" "${XDG_CACHE_HOME:-$HOME/.cache}/servemedia/flatpak-context")"
  if network_up; then
    podman build -t "$IMAGE" -f "$ctx/containerfile" "$ctx"
    return
  fi
  if ! podman image exists "$IMAGE"; then
    echo "error: $IMAGE missing; need network for first image build" >&2
    exit 1
  fi
}

fedora_run() {
  local action="$1"
  local version
  version="$(app_version)"
  version="${version:-0.0.0}"
  mkdir -p "$BUILD/package" "$BUILD/cache/flatpak"
  : >"$BUILD/package/.gitkeep"
  : >"$BUILD/cache/.gitkeep"
  podman run --rm --privileged \
    --security-opt label=disable \
    -e IN_CONTAINER=1 \
    -e ACTION="$action" \
    -e VERSION="$version" \
    -e SRC=/src \
    -e CACHE=/cache \
    -e OUT=/out \
    -e PREPARE_MODE="${PREPARE_MODE:-online}" \
    -v "$ROOT:/src:z" \
    -v "$BUILD/cache/flatpak:/cache:z" \
    -v "$BUILD/package:/out:z" \
    "$IMAGE" \
    bash /src/flatpak/build
}

golang_regen() {
  local sm_tag pin_mode sm_commit
  sm_tag="${SERVEMEDIA_TAG:-}"
  pin_mode="${PIN_MODE:-path}"
  sm_commit="${SERVEMEDIA_COMMIT:-}"
  mkdir -p "$PINS"
  podman run --rm \
    -e IN_CONTAINER=1 \
    -e ACTION=regen \
    -e SRC=/src \
    -e SERVEMEDIA_REPO="$SM_REPO" \
    -e SERVEMEDIA_TAG="$sm_tag" \
    -e SERVEMEDIA_COMMIT="$sm_commit" \
    -e PIN_MODE="$pin_mode" \
    -v "$ROOT:/src:z" \
    docker.io/library/golang:1.26-bookworm \
    bash /src/flatpak/build
}

gh_json() {
  curl -fsSL -A "$UA" -H "Accept: application/vnd.github+json" "$1"
}

tag_commit() {
  python3 -c '
import json, sys, urllib.request
ua, url = sys.argv[1], sys.argv[2]
req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": ua})
ref = json.load(urllib.request.urlopen(req))
obj = ref["object"]
if obj["type"] == "commit":
    print(obj["sha"])
    raise SystemExit
req = urllib.request.Request(obj["url"], headers={"Accept": "application/vnd.github+json", "User-Agent": ua})
tag = json.load(urllib.request.urlopen(req))
print(tag["object"]["sha"])
' "$UA" "$1"
}

hash_url() {
  curl -fL -A "$UA" --retry 3 --retry-delay 1 "$1" | sha256sum | awk '{print $1}'
}

update_metainfo() {
  local ver="$1" date="$2"
  python3 - "$META" "$ver" "$date" <<'PY'
import pathlib, re, sys
path, ver, date = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
meta = path.read_text()
meta, n = re.subn(
    r'<release version="[^"]*" date="[^"]*"/>',
    f'<release version="{ver}" date="{date}"/>',
    meta,
    count=1,
)
if n != 1:
    sys.exit("error: could not update metainfo release")
path.write_text(meta)
PY
}

apply_yml_vendor_and_git() {
  python3 - "$YML" "$@" <<'PY'
import pathlib, re, sys

yml_path = pathlib.Path(sys.argv[1])
sm_tag, sm_commit = sys.argv[2], sys.argv[3]
args = sys.argv[4:]
yml = yml_path.read_text()

def pin_git(yml, url, tag, commit):
    if not commit or commit == "0":
        block = rf"(url: {re.escape(url)}\n        tag: )v[\d.]+"
        out, n = re.subn(block, rf"\g<1>{tag}", yml, count=1)
        return out if n == 1 else yml
    block = (
        rf"(url: {re.escape(url)}\n"
        rf"        tag: )v[\d.]+\n"
        rf"(        commit: )[0-9a-f]+\n"
    )
    out, n = re.subn(block, rf"\g<1>{tag}\n\g<2>{commit}\n", yml, count=1)
    if n != 1 and "ServeMedia" in url:
        return yml
    if n != 1:
        sys.exit(4)
    return out

yml = pin_git(yml, "https://github.com/AlyShmahell/ServeMedia.git", sm_tag, sm_commit)

def pin_file(yml, dest, url, sha):
    block = (
        rf"(- type: file\n"
        rf"        url: ).+\n"
        rf"(        sha256: )[0-9a-f]+\n"
        rf"(        dest-filename: {re.escape(dest)}\n)"
    )
    repl = rf"\g<1>{url}\n\g<2>{sha}\n\g<3>"
    out, n = re.subn(block, repl, yml, count=1)
    if n != 1:
        sys.exit(5)
    return out

if len(args) < 37:
    sys.exit("error: apply_yml_vendor_and_git arg count")
for j in range(11):
    dest, url, sha = args[j * 3], args[j * 3 + 1], args[j * 3 + 2]
    yml = pin_file(yml, dest, url, sha)
notices = args[33:37]

def pin_notice(yml, dest, url):
    block = rf"(printf '%s\\n' ')[^']+(' >/app/vendor/{re.escape(dest)})"
    out, n = re.subn(block, rf"\g<1>{url}\g<2>", yml, count=1)
    if n != 1:
        sys.exit(6)
    return out

yml = pin_notice(yml, "htmx.min.js.NOTICE", notices[0])
yml = pin_notice(yml, "video.js/LICENSE.NOTICE", notices[1])
yml = pin_notice(yml, "hls.min.js.NOTICE", notices[2])
yml = pin_notice(yml, "codemirror/LICENSE.NOTICE", notices[3])
yml_path.write_text(yml)
PY
}

do_resync_online() {
  local json cfg vend
  json="$(mktemp)"
  cfg="$(mktemp)"
  vend="$(mktemp)"
  trap 'rm -f "'"$json"'" "'"$cfg"'" "'"$vend"'"' RETURN
  if ! gh_json "https://api.github.com/repos/${SM_REPO}/releases/latest" >"$json"; then
    echo "error: could not fetch latest release for ${SM_REPO}" >&2
    exit 1
  fi
  eval "$(python3 -c '
import json, sys
rel = json.load(open(sys.argv[1]))
tag = (rel.get("tag_name") or "").strip()
if tag.startswith("v"):
    ver = tag[1:]
else:
    ver = tag
pub = (rel.get("published_at") or "")[:10]
if not tag or len(pub) != 10:
    sys.exit(2)
print("TAG=" + json.dumps(tag))
print("VER=" + json.dumps(ver))
print("DATE=" + json.dumps(pub))
' "$json")" || {
    echo "error: latest ${SM_REPO} release has no tag/date" >&2
    exit 1
  }
  SM_COMMIT="$(tag_commit "https://api.github.com/repos/${SM_REPO}/git/refs/tags/${TAG}")"
  curl -fL -A "$UA" --retry 3 --retry-delay 1 -o "$cfg" \
    "https://raw.githubusercontent.com/${SM_REPO}/${TAG}/src/share/config/default.yaml"
  curl -fL -A "$UA" --retry 3 --retry-delay 1 -o "$vend" \
    "https://raw.githubusercontent.com/${SM_REPO}/${TAG}/src/share/vendor.yaml"
  eval "$(parse_version_yaml "$cfg")" || {
    echo "error: default.yaml on ${TAG} missing version" >&2
    exit 1
  }
  eval "$(parse_vendor_yaml "$vend")" || {
    echo "error: vendor.yaml on ${TAG} missing assets" >&2
    exit 1
  }
  HTMX_SHA="$(hash_url "$HTMX_URL")"
  HTMX_LIC_SHA="$(hash_url "$HTMX_LICENSE_URL")"
  VIDEOJS_JS_SHA="$(hash_url "$VIDEOJS_JS_URL")"
  VIDEOJS_CSS_SHA="$(hash_url "$VIDEOJS_CSS_URL")"
  VIDEOJS_LIC_SHA="$(hash_url "$VIDEOJS_LICENSE_URL")"
  HLS_SHA="$(hash_url "$HLS_URL")"
  HLS_LIC_SHA="$(hash_url "$HLS_LICENSE_URL")"
  CM_JS_SHA="$(hash_url "$CODEMIRROR_JS_URL")"
  CM_CSS_SHA="$(hash_url "$CODEMIRROR_CSS_URL")"
  CM_YAML_SHA="$(hash_url "$CODEMIRROR_YAML_URL")"
  CM_LIC_SHA="$(hash_url "$CODEMIRROR_LICENSE_URL")"
  apply_yml_vendor_and_git \
    "$TAG" "$SM_COMMIT" \
    htmx.min.js "$HTMX_URL" "$HTMX_SHA" \
    htmx.min.js.LICENSE "$HTMX_LICENSE_URL" "$HTMX_LIC_SHA" \
    video.min.js "$VIDEOJS_JS_URL" "$VIDEOJS_JS_SHA" \
    video-js.min.css "$VIDEOJS_CSS_URL" "$VIDEOJS_CSS_SHA" \
    videojs.LICENSE "$VIDEOJS_LICENSE_URL" "$VIDEOJS_LIC_SHA" \
    hls.min.js "$HLS_URL" "$HLS_SHA" \
    hls.min.js.LICENSE "$HLS_LICENSE_URL" "$HLS_LIC_SHA" \
    codemirror.min.js "$CODEMIRROR_JS_URL" "$CM_JS_SHA" \
    codemirror.min.css "$CODEMIRROR_CSS_URL" "$CM_CSS_SHA" \
    yaml.min.js "$CODEMIRROR_YAML_URL" "$CM_YAML_SHA" \
    codemirror.LICENSE "$CODEMIRROR_LICENSE_URL" "$CM_LIC_SHA" \
    "$HTMX_LICENSE_URL" "$VIDEOJS_LICENSE_URL" "$HLS_LICENSE_URL" "$CODEMIRROR_LICENSE_URL"
  update_metainfo "$VER" "$DATE"
  echo "resync online: ${TAG}@${SM_COMMIT}"
  SERVEMEDIA_TAG="$TAG"
  SERVEMEDIA_COMMIT="$SM_COMMIT"
  PIN_MODE=url
}

do_resync_offline() {
  eval "$(parse_version_yaml "$DEFAULT_YAML")" || {
    echo "error: local default.yaml missing version" >&2
    exit 1
  }
  eval "$(parse_vendor_yaml "$VENDOR_YAML")" || {
    echo "error: local vendor.yaml missing assets" >&2
    exit 1
  }
  DATE="$(date -u +%Y-%m-%d)"
  SM_TAG="$(yml_git_tag "https://github.com/${SM_REPO}.git")"
  SM_COMMIT="$(yml_git_commit "https://github.com/${SM_REPO}.git")"
  if network_up; then
    HTMX_SHA="$(hash_url "$HTMX_URL")"
    HTMX_LIC_SHA="$(hash_url "$HTMX_LICENSE_URL")"
    VIDEOJS_JS_SHA="$(hash_url "$VIDEOJS_JS_URL")"
    VIDEOJS_CSS_SHA="$(hash_url "$VIDEOJS_CSS_URL")"
    VIDEOJS_LIC_SHA="$(hash_url "$VIDEOJS_LICENSE_URL")"
    HLS_SHA="$(hash_url "$HLS_URL")"
    HLS_LIC_SHA="$(hash_url "$HLS_LICENSE_URL")"
    CM_JS_SHA="$(hash_url "$CODEMIRROR_JS_URL")"
    CM_CSS_SHA="$(hash_url "$CODEMIRROR_CSS_URL")"
    CM_YAML_SHA="$(hash_url "$CODEMIRROR_YAML_URL")"
    CM_LIC_SHA="$(hash_url "$CODEMIRROR_LICENSE_URL")"
    apply_yml_vendor_and_git \
      "${SM_TAG:-v0.0.0}" "${SM_COMMIT:-0}" \
      htmx.min.js "$HTMX_URL" "$HTMX_SHA" \
      htmx.min.js.LICENSE "$HTMX_LICENSE_URL" "$HTMX_LIC_SHA" \
      video.min.js "$VIDEOJS_JS_URL" "$VIDEOJS_JS_SHA" \
      video-js.min.css "$VIDEOJS_CSS_URL" "$VIDEOJS_CSS_SHA" \
      videojs.LICENSE "$VIDEOJS_LICENSE_URL" "$VIDEOJS_LIC_SHA" \
      hls.min.js "$HLS_URL" "$HLS_SHA" \
      hls.min.js.LICENSE "$HLS_LICENSE_URL" "$HLS_LIC_SHA" \
      codemirror.min.js "$CODEMIRROR_JS_URL" "$CM_JS_SHA" \
      codemirror.min.css "$CODEMIRROR_CSS_URL" "$CM_CSS_SHA" \
      yaml.min.js "$CODEMIRROR_YAML_URL" "$CM_YAML_SHA" \
      codemirror.LICENSE "$CODEMIRROR_LICENSE_URL" "$CM_LIC_SHA" \
      "$HTMX_LICENSE_URL" "$VIDEOJS_LICENSE_URL" "$HLS_LICENSE_URL" "$CODEMIRROR_LICENSE_URL"
  fi
  update_metainfo "$VER" "$DATE"
  echo "resync offline: version=${VER}"
  SERVEMEDIA_TAG=""
  SERVEMEDIA_COMMIT=""
  PIN_MODE=path
}

do_install_host() {
  local bundle
  need_flatpak
  bundle="$BUILD/package/servemedia-linux-amd64.flatpak"
  if [[ ! -f "$bundle" ]]; then
    echo "error: package missing: $bundle" >&2
    exit 1
  fi
  flatpak install --user -y --reinstall "$bundle"
  echo "installed $bundle"
}

run_pipeline() {
  local mode="$1"
  PIPELINE="$mode"
  export PIPELINE
  need_podman
  ensure_builder_image

  echo "==> resync ($mode)"
  if [[ "$mode" == online ]]; then
    do_resync_online
  else
    do_resync_offline
  fi

  echo "==> regen ($mode)"
  golang_regen

  echo "==> lint ($mode)"
  PREPARE_MODE="$mode"
  if [[ "$mode" == online ]]; then
    fedora_run lint
  else
    if network_up; then
      fedora_run lint
    else
      fedora_run lint-offline
    fi
  fi

  echo "==> build ($mode)"
  PREPARE_MODE="$mode"
  if [[ "$mode" == online ]]; then
    fedora_run build
  else
    if network_up; then
      fedora_run build
    else
      fedora_run build-offline
    fi
  fi

  echo "==> package ($mode)"
  if [[ "$mode" == online ]] || network_up; then
    fedora_run package
  else
    fedora_run package-offline
  fi

  echo "==> install ($mode)"
  do_install_host
}

need_podman
CHOICE=
menu "online" "offline"
case "$CHOICE" in
  0) run_pipeline online ;;
  1) run_pipeline offline ;;
esac
