# Host path bind-mounted at /media (read-write).
# Under rootless Podman the app runs as container root (maps to your host user), so MEDIA_PATH
# must be writable by that host user. Medora does not chown /media.
# On SELinux + exFAT, compose uses security_opt: label=disable.
MEDIA_PATH=/mnt/microsd/media
# Used by medora-providers sidecar only (not read by the main medora binary).
# OMDB_API_KEY=
# Optional OMDb endpoint override (smoke tests set this to the local stub).
# OMDB_BASE_URL=https://www.omdbapi.com/
# MEDORA_HTTP_ADDR=:7676
# MEDORA_PROVIDERS_SOCKET=/data/run/providers.sock
# VAAPI: compose mounts /dev/dri. For rootless Podman, ensure your user is in the video and/or render groups.
